@model Veltrix.Models.Order

@{
    ViewData["Title"] = $"Order #{Model.OrderNumber}";

    var history = ViewBag.StatusHistory as
        IEnumerable<Veltrix.DTOs.OrderStatusDTO.OrderStatusHistoryDto>
        ?? Enumerable.Empty<Veltrix.DTOs.OrderStatusDTO.OrderStatusHistoryDto>();
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <a asp-action="Index" class="text-decoration-none small">
                ← Back to Orders
            </a>

            <h2 class="mt-2 mb-1">
                Order #@Model.OrderNumber
            </h2>

            <p class="text-muted mb-0">
                Created on @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
            </p>
        </div>

        <span class="badge bg-secondary fs-6">
            @Model.OrderStatus
        </span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-8">

            <!-- Order Items -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="mb-3">Order Items</h5>

                    <div class="table-responsive">
                        <table class="table align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>SKU</th>
                                    <th>Unit Price</th>
                                    <th>Quantity</th>
                                    <th>Cancelled</th>
                                    <th>Fulfilled</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.OrderItems == null || !Model.OrderItems.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            No order items found.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.OrderItems)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">
                                                    @item.ProductName
                                                </div>

                                                @if (item.ProductVariant != null)
                                                {
                                                    <small class="text-muted">
                                                        @item.VariantName
                                                    </small>
                                                }
                                            </td>

                                            <td>@item.SKU</td>

                                            <td>@item.UnitPrice.ToString("N2")</td>

                                            <td>@item.Quantity</td>

                                            <td>
                                                @item.CancelledQuantity
                                            </td>

                                            <td>
                                                @item.FulfilledQuantity
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>

                        </table>
                    </div>
                </div>
            </div>

            <!-- Shipping Information -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="mb-3">Shipping Information</h5>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <div class="text-muted small">Recipient</div>
                            <div class="fw-semibold">
                                @Model.ShippingRecipientName
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Phone Number</div>
                            <div class="fw-semibold">
                                @Model.ShippingPhoneNumber
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="text-muted small">Address</div>
                            <div>
                                @Model.ShippingAddressLine1
                                @if (!string.IsNullOrWhiteSpace(Model.ShippingAddressLine2))
                                {
                                    <span>, @Model.ShippingAddressLine2</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">City</div>
                            <div>@Model.ShippingCity</div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Governorate</div>
                            <div>@Model.ShippingGovernorate</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.ShippingPostalCode))
                        {
                            <div class="col-md-6">
                                <div class="text-muted small">Postal Code</div>
                                <div>@Model.ShippingPostalCode</div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.ShippingInstructions))
                        {
                            <div class="col-12">
                                <div class="text-muted small">Delivery Instructions</div>
                                <div>@Model.ShippingInstructions</div>
                            </div>
                        }

                    </div>
                </div>
            </div>

            <!-- Status History -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="mb-3">Status History</h5>

                    @if (!history.Any())
                    {
                        <p class="text-muted mb-0">
                            No status history available.
                        </p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">

                                <thead class="table-light">
                                    <tr>
                                        <th>Previous Status</th>
                                        <th>New Status</th>
                                        <th>Note</th>
                                        <th>Changed At</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var entry in history.OrderByDescending(x => x.ChangedAt))
                                    {
                                        <tr>
                                            <td>
                                                @(entry.PreviousStatus?.ToString() ?? "—")
                                            </td>

                                            <td>
                                                <span class="badge bg-secondary">
                                                    @entry.NewStatus
                                                </span>
                                            </td>

                                            <td>
                                                @(string.IsNullOrWhiteSpace(entry.Note) ? "—" : entry.Note)
                                            </td>

                                            <td>
                                                @entry.ChangedAt.ToString("dd MMM yyyy, hh:mm tt")
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                    }
                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <!-- Order Summary -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="mb-3">Order Summary</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span>@Model.Subtotal.ToString("N2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Discount</span>
                        <span class="text-success">
                            -@Model.DiscountAmount.ToString("N2")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Shipping</span>
                        <span>@Model.ShippingFee.ToString("N2")</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Total</span>
                        <span>@Model.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <!-- Payment -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="mb-3">Payment</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Method</span>
                        <span>@Model.PaymentMethod</span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Status</span>
                        <span>@Model.PaymentStatus</span>
                    </div>
                </div>
            </div>

            <!-- Update Order Status -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="mb-2">Update Order Status</h5>

                    <p class="text-muted small">
                        Select the next status allowed by the order workflow.
                    </p>

                    <form asp-action="UpdateStatus"
                          asp-route-orderId="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="OrderStatus" class="form-label">
                                New Status
                            </label>

                            <select id="OrderStatus"
                                    name="OrderStatus"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<Veltrix.Enums.OrderStatus>()">
                                <option value="">Select status</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Update Status
                        </button>
                    </form>
                </div>
            </div>

            @if (Model.CancelledAt.HasValue)
            {
                <div class="card border-0 shadow-sm border-start border-danger border-4">
                    <div class="card-body p-4">
                        <h5 class="text-danger mb-2">Cancellation Details</h5>

                        <div class="text-muted small mb-1">Cancelled At</div>
                        <div class="mb-3">
                            @Model.CancelledAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                        </div>

                        <div class="text-muted small mb-1">Reason</div>
                        <p class="mb-0">
                            @(Model.CancelReason ?? "No reason provided.")
                        </p>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
