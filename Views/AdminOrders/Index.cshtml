@model IReadOnlyList<Veltrix.DTOs.OrderDTO.OrderSummaryDto>

@{
    ViewData["Title"] = "Manage Orders";

    var filters = ViewBag.Filters as Veltrix.Repositories.Order.OrderFilterParameters
        ?? new Veltrix.Repositories.Order.OrderFilterParameters();

    int totalPages = ViewBag.TotalPages ?? 0;
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="container-fluid py-4 admin-orders-page">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">Orders</h2>
            <p class="text-muted mb-0">Manage customer orders and monitor their status.</p>
        </div>

        <div class="admin-orders-count">
            <strong>@totalCount</strong> total orders
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters -->
    <div class="card admin-orders-filter-card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="admin-orders-filter-form">

                <div class="admin-filter-field">
                    <label class="form-label">Order Number</label>
                    <input name="OrderNumber"
                           value="@filters.OrderNumber"
                           class="form-control"
                           placeholder="Search order number..." />
                </div>

                <div class="admin-filter-field">
                    <label class="form-label">Customer User ID</label>
                    <input name="UserId"
                           value="@filters.UserId"
                           class="form-control"
                           placeholder="Customer ID..." />
                </div>

                <div class="admin-filter-field">
                    <label class="form-label">Order Status</label>
                    <select name="OrderStatus"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<Veltrix.Enums.OrderStatus>()">
                        <option value="">All statuses</option>
                    </select>
                </div>

                <div class="admin-filter-field">
                    <label class="form-label">From Date</label>
                    <input type="date"
                           name="FromDate"
                           value="@filters.FromDate?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="admin-filter-field">
                    <label class="form-label">To Date</label>
                    <input type="date"
                           name="ToDate"
                           value="@filters.ToDate?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <input type="hidden" name="PageNumber" value="1" />
                <input type="hidden" name="PageSize" value="@filters.PageSize" />

                <div class="admin-filter-actions">
                    <button type="submit" class="vx-btn-primary">
                        <i class="bi bi-search me-1"></i>
                        Apply
                    </button>

                    <a asp-action="Index" class="vx-btn-secondary">
                        Clear
                    </a>
                </div>

            </form>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="card admin-orders-table-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Subtotal</th>
                        <th>Total</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="admin-orders-empty">
                                    <i class="bi bi-receipt"></i>
                                    <h6 class="mt-3 mb-1">No orders found</h6>
                                    <p class="text-muted mb-0">
                                        Try changing your filters.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold order-number">
                                        #@order.OrderNumber
                                    </div>
                                    <small class="text-muted">
                                        ID: @order.Id
                                    </small>
                                </td>

                                <td>
                                    <div>@order.CreatedAt.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted">
                                        @order.CreatedAt.ToString("hh:mm tt")
                                    </small>
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @order.OrderStatus
                                    </span>
                                </td>

                                <td>
                                    <div>@order.PaymentMethod</div>
                                    <small class="text-muted">
                                        @order.PaymentStatus
                                    </small>
                                </td>

                                <td>@order.Subtotal.ToString("N2")</td>

                                <td class="fw-semibold">
                                    @order.TotalAmount.ToString("N2")
                                </td>

                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="admin-order-view-btn">
                                        View Details
                                        <i class="bi bi-arrow-up-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav class="admin-orders-pagination mt-4" aria-label="Orders pagination">
            <ul class="pagination justify-content-center">

                <li class="page-item @(filters.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-PageNumber="@(filters.PageNumber - 1)"
                       asp-route-PageSize="@filters.PageSize"
                       asp-route-OrderNumber="@filters.OrderNumber"
                       asp-route-UserId="@filters.UserId"
                       asp-route-OrderStatus="@filters.OrderStatus"
                       asp-route-FromDate="@filters.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-ToDate="@filters.ToDate?.ToString("yyyy-MM-dd")">
                        Previous
                    </a>
                </li>

                <li class="page-item disabled">
                    <span class="page-link">
                        Page @filters.PageNumber of @totalPages
                    </span>
                </li>

                <li class="page-item @(filters.PageNumber >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-PageNumber="@(filters.PageNumber + 1)"
                       asp-route-PageSize="@filters.PageSize"
                       asp-route-OrderNumber="@filters.OrderNumber"
                       asp-route-UserId="@filters.UserId"
                       asp-route-OrderStatus="@filters.OrderStatus"
                       asp-route-FromDate="@filters.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-ToDate="@filters.ToDate?.ToString("yyyy-MM-dd")">
                        Next
                    </a>
                </li>

            </ul>
        </nav>
    }

</div>
