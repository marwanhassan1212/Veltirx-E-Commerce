@model IReadOnlyList<Veltrix.DTOs.ProductImageDTO.ProductImageDto>

@{
    ViewData["Title"] = "Product Images";
    int productId = (int)ViewBag.ProductId;
}

<style>
    .vx-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 28px;
    }

    .vx-page-title {
        font-size: 25px;
        font-weight: 750;
        color: #1e293b;
        margin-bottom: 5px;
    }

    .vx-page-subtitle {
        color: #64748b;
        font-size: 13px;
        margin: 0;
    }

    .vx-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 16px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s ease;
    }

    .vx-btn-primary {
        background: #4f46e5;
        color: #fff;
        border: 1px solid #4f46e5;
    }

        .vx-btn-primary:hover {
            background: #4338ca;
            color: #fff;
            transform: translateY(-1px);
        }

    .vx-btn-outline {
        background: #fff;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

        .vx-btn-outline:hover {
            background: #f8fafc;
            color: #1e293b;
        }

    .vx-stat-card {
        background: #fff;
        border: 1px solid #eef0f4;
        border-radius: 12px;
        padding: 20px;
        height: 100%;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .03);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .vx-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(15, 23, 42, .06);
        }

    .vx-stat-label {
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .vx-stat-value {
        color: #1e293b;
        font-size: 25px;
        font-weight: 750;
        margin: 0;
    }

    .vx-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        flex-shrink: 0;
    }

    .vx-gallery-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
    }

    .vx-gallery-title {
        color: #1e293b;
        font-size: 16px;
        font-weight: 700;
        margin: 0;
    }

    .vx-gallery-count {
        color: #64748b;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 5px 11px;
        font-size: 11px;
        font-weight: 600;
    }

    .vx-image-card {
        border: 1px solid #eef0f4;
        border-radius: 13px;
        overflow: hidden;
        background: #fff;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .vx-image-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 9px 24px rgba(15, 23, 42, .08);
        }

    .vx-image-preview {
        height: 240px;
        background: linear-gradient(145deg, #f8fafc, #eef2f7);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 16px;
    }

        .vx-image-preview img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            transition: transform .3s ease;
        }

    .vx-image-card:hover .vx-image-preview img {
        transform: scale(1.04);
    }

    .vx-primary-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 700;
        box-shadow: 0 2px 5px rgba(0, 0, 0, .04);
    }

    .vx-image-body {
        padding: 16px;
        flex: 1;
    }

    .vx-image-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
    }

    .vx-image-id {
        color: #64748b;
        font-size: 11px;
        font-weight: 600;
    }

    .vx-alt-text {
        color: #334155;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 12px;
        min-height: 18px;
    }

    .vx-image-date {
        color: #94a3b8;
        font-size: 11px;
    }

    .vx-image-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        border-top: 1px solid #f1f5f9;
        background: #fff;
    }

    .vx-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 8px 10px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: all .2s ease;
    }

    .vx-image-actions form {
        margin: 0;
    }

    .vx-empty-state {
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        padding: 65px 20px;
        text-align: center;
    }

    .vx-empty-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 18px;
        border-radius: 18px;
        background: #eef2ff;
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    @@media (max-width: 576px) {
        .vx-page-title {
            font-size: 21px;
        }

        .vx-page-actions {
            width: 100%;
        }

            .vx-page-actions a {
                flex: 1;
            }

        .vx-image-preview {
            height: 220px;
        }

        .vx-image-actions {
            padding: 10px;
            gap: 6px;
        }

        .vx-action-btn {
            padding: 7px 8px;
            font-size: 10px;
        }
    }
</style>

<div class="container-fluid py-4">

    <div class="vx-page-header">
        <div>
            <h2 class="vx-page-title">Product Images</h2>
            <p class="vx-page-subtitle">
                Manage and organize your product gallery
            </p>
        </div>

        <div class="d-flex gap-2 vx-page-actions">
            <a asp-controller="Product"
               asp-action="Details"
               asp-route-id="@productId"
               class="vx-btn vx-btn-outline">
                <i class="bi bi-arrow-left"></i>
                Back to Product
            </a>

            <a asp-action="Create"
               asp-route-productId="@productId"
               class="vx-btn vx-btn-primary">
                <i class="bi bi-plus-lg"></i>
                Upload Image
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4"
             role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="vx-stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="vx-stat-label">TOTAL IMAGES</div>
                        <h3 class="vx-stat-value">@Model.Count</h3>
                    </div>

                    <div class="vx-stat-icon"
                         style="background:#eef2ff;color:#4f46e5;">
                        <i class="bi bi-images"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="vx-stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="vx-stat-label">PRIMARY IMAGE</div>
                        <h3 class="vx-stat-value fs-5">
                            @(Model.Any(x => x.IsPrimary) ? "Assigned" : "Not Assigned")
                        </h3>
                    </div>

                    <div class="vx-stat-icon"
                         style="background:#dcfce7;color:#16a34a;">
                        <i class="bi bi-star-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="vx-stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="vx-stat-label">ADDITIONAL IMAGES</div>
                        <h3 class="vx-stat-value">
                            @Model.Count(x => !x.IsPrimary)
                        </h3>
                    </div>

                    <div class="vx-stat-icon"
                         style="background:#fff7ed;color:#ea580c;">
                        <i class="bi bi-card-image"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="vx-empty-state">
            <div class="vx-empty-icon">
                <i class="bi bi-images"></i>
            </div>

            <h4 class="fw-bold mb-2">No Images Yet</h4>

            <p class="text-muted small mb-4">
                This product doesn't have any images yet.
                Upload your first image to showcase it.
            </p>

            <a asp-action="Create"
               asp-route-productId="@productId"
               class="vx-btn vx-btn-primary">
                <i class="bi bi-plus-lg"></i>
                Upload First Image
            </a>
        </div>
    }
    else
    {
        <div class="vx-gallery-heading">
            <h5 class="vx-gallery-title">Image Gallery</h5>

            <span class="vx-gallery-count">
                @Model.Count image(s)
            </span>
        </div>

        <div class="row g-4">

            @foreach (var image in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="vx-image-card">

                        <div class="vx-image-preview">
                            <img src="@image.ImageUrl"
                                 alt="@image.AltText"
                                 loading="lazy" />

                            @if (image.IsPrimary)
                            {
                                <span class="vx-primary-badge">
                                    <i class="bi bi-star-fill me-1"></i>
                                    PRIMARY
                                </span>
                            }
                    </div>

                    <div class="vx-image-body">

                        <p class="vx-alt-text text-truncate"
                           title="@(string.IsNullOrWhiteSpace(image.AltText) ? "No alternative text" : image.AltText)">
                            @(string.IsNullOrWhiteSpace(image.AltText)
                                                    ? "No alternative text"
                                                    : image.AltText)
                    </p>

                            <div class="vx-image-date">
                                <i class="bi bi-calendar3 me-1"></i>
                                @image.CreatedAt.ToString("dd MMM yyyy")
                            </div>

                        </div>

                        <div class="vx-image-actions">

                            <a asp-action="Edit"
                               asp-route-id="@image.Id"
                               class="vx-action-btn btn btn-outline-primary flex-fill">
                                <i class="bi bi-pencil"></i>
                                Edit
                            </a>

                    @if (!image.IsPrimary)
                            {
                                <form asp-action="SetPrimary"
                                      asp-route-id="@image.Id"
                                      method="post"
                                      class="flex-fill">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="vx-action-btn btn btn-outline-success w-100">
                                        <i class="bi bi-star"></i>
                                        Primary
                                    </button>
                                </form>
                            }

                            <form asp-action="Delete"
                                  asp-route-id="@image.Id"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this image?');">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="vx-action-btn btn btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>

                        </div>

                    </div>
                </div>
            }

        </div>
    }

</div>