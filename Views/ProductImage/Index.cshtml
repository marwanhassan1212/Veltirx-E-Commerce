@model IReadOnlyList<Veltrix.DTOs.ProductImageDTO.ProductImageDto>

@{
    ViewData["Title"] = "Product Images";
    int productId = (int)ViewBag.ProductId;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1">Product Images</h2>
            <p class="text-muted mb-0">
                Manage images for Product #@productId
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Product"
               asp-action="Details"
               asp-route-id="@productId"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Product
            </a>

            <a asp-action="Create"
               asp-route-productId="@productId"
               class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Upload Image
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Images</div>
                    <h3 class="fw-bold mb-0">@Model.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Primary Image</div>
                    <h3 class="fw-bold mb-0">
                        @(Model.Any(x => x.IsPrimary) ? "Assigned" : "Not Assigned")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Additional Images</div>
                    <h3 class="fw-bold mb-0">
                        @Model.Count(x => !x.IsPrimary)
                    </h3>
                </div>
            </div>
        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-images display-3 text-muted"></i>
                <h4 class="fw-bold mt-3">No Images Yet</h4>
                <p class="text-muted">
                    Upload images to showcase this product.
                </p>

                <a asp-action="Create"
                   asp-route-productId="@productId"
                   class="btn btn-primary mt-2">
                    Upload First Image
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var image in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="card border-0 shadow-sm h-100">

                        <div class="position-relative">
                            <img src="@image.ImageUrl"
                                 alt="@image.AltText"
                                 class="card-img-top"
                                 style="height:220px; object-fit:cover;" />

                            @if (image.IsPrimary)
                            {
                                <span class="badge bg-success position-absolute top-0 start-0 m-2">
                                    <i class="bi bi-star-fill"></i> Primary
                                </span>
                            }
                    </div>

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">
                                Image #@image.Id
                            </span>

                            <span class="badge bg-light text-dark">
                                Order: @image.DisplayOrder
                            </span>
                        </div>

                        <p class="mb-2 text-truncate">
                            @(string.IsNullOrWhiteSpace(image.AltText)
                                                    ? "No alternative text"
                                                    : image.AltText)
                    </p>

                            <small class="text-muted">
                                @image.CreatedAt.ToString("dd MMM yyyy")
                            </small>

                        </div>

                        <div class="card-footer bg-white border-0 d-flex gap-2">

                            <a asp-action="Edit"
                               asp-route-id="@image.Id"
                               class="btn btn-outline-primary btn-sm flex-fill">
                                <i class="bi bi-pencil"></i> Edit
                            </a>

                    @if (!image.IsPrimary)
                            {
                                <form asp-action="SetPrimary"
                                      asp-route-id="@image.Id"
                                      method="post"
                                      class="flex-fill">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-success btn-sm w-100">
                                        <i class="bi bi-star"></i> Set Primary
                                    </button>
                                </form>
                            }

                            <form asp-action="Delete"
                                  asp-route-id="@image.Id"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this image?');">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>

                        </div>

                    </div>
                </div>
            }

        </div>
    }

</div>
