@model IReadOnlyList<Veltrix.DTOs.ProductImageDTO.ProductImageDto>

@{
    ViewData["Title"] = "Product Images";
    var productId = (int)ViewBag.ProductId;
}

<div class="container-fluid products-page product-images-page">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Product Images</h2>
            <p class="text-muted mb-0">
                Manage images and choose the main image for your product.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">

            <a asp-controller="Product"
               asp-action="Index"
               class="vx-btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Back to Products
            </a>

            <a asp-action="Create"
               asp-route-productId="@productId"
               class="vx-btn-primary">
                <i class="bi bi-plus-lg"></i>
                Upload Image
            </a>

        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Gallery Summary -->
    <div class="card border-0 product-images-summary mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div>
                <h6 class="mb-1 fw-semibold">Image Gallery</h6>
                <span class="text-muted small">
                    Product #@productId
                </span>
            </div>

            <div class="product-images-count">
                <i class="bi bi-images me-1"></i>
                @Model.Count @(Model.Count == 1 ? "Image" : "Images")
            </div>

        </div>
    </div>

    @if (Model.Any())
    {
        <!-- Images Gallery -->
        <div class="row g-4">

            @foreach (var image in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">

                    <div class="card border-0 product-image-card h-100">

                        <!-- Image -->
                        <div class="product-image-wrapper">

                            <img src="@image.ImageUrl"
                                 alt="@(image.AltText ?? "Product image")"
                                 class="product-gallery-image"
                                 loading="lazy" />

                            @if (image.IsPrimary)
                            {
                                <span class="product-primary-badge">
                                    <i class="bi bi-star-fill"></i>
                                    Primary Image
                                </span>
                            }

                        </div>

                        <!-- Content -->
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <span class="text-muted small">
                                    Image #@image.Id
                                </span>

                                @if (image.IsPrimary)
                                {
                                    <span class="status-badge status-published">
                                        Primary
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-unpublished">
                                        Secondary
                                    </span>
                                }

                        </div>

                        <p class="product-image-alt mb-2">
                            @(string.IsNullOrWhiteSpace(image.AltText)
                                                    ? "No alternative text"
                                                    : image.AltText)
                    </p>

                            <div class="text-muted small">
                                <i class="bi bi-calendar3 me-1"></i>
                                @image.CreatedAt.ToString("dd MMM yyyy")
                            </div>

                        </div>

                        <!-- Actions -->
                        <div class="card-footer bg-white border-0 pt-0">

                            <div class="product-image-actions">

                                <a asp-action="Edit"
                                   asp-route-id="@image.Id"
                                   class="vx-btn-secondary"
                                   title="Edit image">
                                    <i class="bi bi-pencil"></i>
                                    Edit
                                </a>

                        @if (!image.IsPrimary)
                                {
                                    <form asp-action="SetPrimary"
                                          asp-route-id="@image.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="vx-btn-primary"
                                                title="Set as primary image">
                                            <i class="bi bi-star"></i>
                                            Make Primary
                                        </button>

                                    </form>
                                }

                                <form asp-action="Delete"
                                      asp-route-id="@image.Id"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this image?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="product-image-delete-btn"
                                            title="Delete image">
                                        <i class="bi bi-trash3"></i>
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 product-images-empty">
            <div class="card-body text-center py-5">

                <div class="product-images-empty-icon mb-3">
                    <i class="bi bi-images"></i>
                </div>

                <h5 class="fw-semibold mb-2">
                    No images uploaded yet
                </h5>

                <p class="text-muted mb-4">
                    Upload your first product image to make your product stand out.
                </p>

                <a asp-action="Create"
                   asp-route-productId="@productId"
                   class="vx-btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Upload First Image
                </a>

            </div>
        </div>
    }

</div>
