@model Veltrix.DTOs.ProductImageDTO.UpdateProductImageDto

@{
    ViewData["Title"] = "Edit Product Image";

    var productId = (int)ViewBag.ProductId;
    var imageId = (int)ViewBag.ImageId;
    var imageUrl = (string)ViewBag.ImageUrl;
}

<div class="container-fluid products-page product-image-form-page">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Edit Product Image</h2>
            <p class="text-muted mb-0">
                Update the image or its alternative text.
            </p>
        </div>

        <a asp-action="Index"
           asp-route-productId="@productId"
           class="vx-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Gallery
        </a>

    </div>

    <!-- Form Card -->
    <div class="card border-0 product-image-form-card">

        <div class="card-body p-4">

            <form asp-action="Edit"
                  asp-route-id="@imageId"
                  method="post"
                  enctype="multipart/form-data"
                  id="editProductImageForm">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="row g-4">

                    <!-- Current / New Image -->
                    <div class="col-lg-7">

                        <label class="form-label fw-semibold">
                            Image Preview
                        </label>

                        <div class="product-image-upload-area">

                            <div class="product-upload-preview" id="previewContainer">

                                <img id="imagePreview"
                                     src="@imageUrl"
                                     alt="Current product image" />

                                <div class="product-preview-info">
                                    <span id="previewStatus">
                                        Current image
                                    </span>
                                </div>

                            </div>

                        </div>

                        <div class="mt-3">

                            <label asp-for="Image" class="form-label">
                                Replace Image <span class="text-muted">(Optional)</span>
                            </label>

                            <input asp-for="Image"
                                   type="file"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                   class="form-control"
                                   id="imageInput" />

                            <span asp-validation-for="Image"
                                  class="text-danger small"></span>

                            <div class="form-text">
                                Leave empty to keep the current image.
                                JPG, JPEG, PNG or WEBP. Maximum 5 MB.
                            </div>

                            <div class="product-upload-error d-none mt-2"
                                 id="uploadError"
                                 role="alert"></div>

                            <button type="button"
                                    id="restoreImageButton"
                                    class="product-restore-image d-none mt-2">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>
                                Keep Current Image
                            </button>

                        </div>

                    </div>

                    <!-- Settings -->
                    <div class="col-lg-5">

                        <div class="product-image-settings">

                            <h6 class="fw-semibold mb-3">
                                <i class="bi bi-sliders me-2"></i>
                                Image Settings
                            </h6>

                            <div class="mb-4">

                                <label asp-for="AltText" class="form-label">
                                    Alternative Text
                                </label>

                                <input asp-for="AltText"
                                       class="form-control"
                                       maxlength="300"
                                       placeholder="Describe the product image..." />

                                <span asp-validation-for="AltText"
                                      class="text-danger small"></span>

                                <div class="form-text">
                                    Describe the image for accessibility.
                                </div>

                            </div>

                            <div class="product-image-hint">
                                <i class="bi bi-info-circle me-2"></i>
                                Replacing the image will not change its primary status.
                            </div>

                        </div>

                    </div>

                </div>

                <!-- Actions -->
                <div class="product-image-form-actions mt-4 pt-3">

                    <a asp-action="Index"
                       asp-route-productId="@productId"
                       class="vx-btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="vx-btn-primary"
                            id="saveImageButton">
                        <i class="bi bi-check-lg"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const imageInput = document.getElementById("imageInput");
            const imagePreview = document.getElementById("imagePreview");
            const previewStatus = document.getElementById("previewStatus");
            const uploadError = document.getElementById("uploadError");
            const restoreButton = document.getElementById("restoreImageButton");
            const form = document.getElementById("editProductImageForm");

            const currentImageUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(imageUrl));

            const maxFileSize = 5 * 1024 * 1024;
            const allowedExtensions = [".jpg", ".jpeg", ".png", ".webp"];

            let previewUrl = null;

            function showError(message) {
                uploadError.textContent = message;
                uploadError.classList.remove("d-none");
            }

            function clearError() {
                uploadError.textContent = "";
                uploadError.classList.add("d-none");
            }

            function restoreCurrentImage() {

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                    previewUrl = null;
                }

                imageInput.value = "";
                imagePreview.src = currentImageUrl;

                previewStatus.textContent = "Current image";
                restoreButton.classList.add("d-none");

                clearError();
            }

            imageInput.addEventListener("change", function () {

                clearError();

                const file = this.files[0];

                if (!file) {
                    restoreCurrentImage();
                    return;
                }

                const extension = file.name.substring(
                    file.name.lastIndexOf(".")
                ).toLowerCase();

                if (!allowedExtensions.includes(extension)) {
                    showError("Unsupported image format. Use JPG, JPEG, PNG or WEBP.");
                    restoreCurrentImage();
                    return;
                }

                if (file.size > maxFileSize) {
                    showError("Image size cannot exceed 5 MB.");
                    restoreCurrentImage();
                    return;
                }

                if (file.size === 0) {
                    showError("The selected image is empty.");
                    restoreCurrentImage();
                    return;
                }

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                }

                previewUrl = URL.createObjectURL(file);

                imagePreview.src = previewUrl;
                previewStatus.textContent = "New image preview";

                restoreButton.classList.remove("d-none");

            });

            restoreButton.addEventListener("click", restoreCurrentImage);

            form.addEventListener("submit", function (event) {

                clearError();

                const file = imageInput.files[0];

                // Replacing the image is optional.
                if (!file) return;

                const extension = file.name.substring(
                    file.name.lastIndexOf(".")
                ).toLowerCase();

                if (!allowedExtensions.includes(extension) ||
                    file.size === 0 ||
                    file.size > maxFileSize) {

                    event.preventDefault();
                    showError("Please select a valid image not exceeding 5 MB.");
                }

            });

            window.addEventListener("beforeunload", function () {
                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                }
            });

        });
    </script>
}
