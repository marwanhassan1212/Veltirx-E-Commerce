@model Veltrix.DTOs.ProductImageDTO.CreateProductImageDto

@{
    ViewData["Title"] = "Upload Product Image";
    int productId = (int)ViewBag.ProductId;
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Upload Product Image</h2>
        <p class="text-muted mb-0">
            Add a new image to Product #@productId
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Create"
                  asp-route-productId="@productId"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="mb-4">
                    <label asp-for="Image" class="form-label fw-semibold">
                        Product Image
                    </label>

                    <input asp-for="Image"
                           type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp"
                           id="imageInput" />

                    <span asp-validation-for="Image"
                          class="text-danger"></span>

                    <small class="text-muted">
                        Supported formats: JPG, JPEG, PNG, WEBP. Maximum size: 5 MB.
                    </small>
                </div>

                <div class="mb-4 text-center">
                    <img id="imagePreview"
                         src="#"
                         alt="Image Preview"
                         class="img-fluid rounded shadow-sm d-none"
                         style="max-height:300px;" />
                </div>

                <div class="mb-3">
                    <label asp-for="AltText" class="form-label fw-semibold">
                        Alternative Text
                    </label>

                    <input asp-for="AltText"
                           class="form-control"
                           placeholder="Describe the image..." />

                    <span asp-validation-for="AltText"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayOrder"
                           class="form-label fw-semibold">
                        Display Order
                    </label>

                    <input asp-for="DisplayOrder"
                           type="number"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="DisplayOrder"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsPrimary"
                           class="form-check-input" />

                    <label asp-for="IsPrimary"
                           class="form-check-label">
                        Set as Primary Image
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-cloud-upload"></i> Upload Image
                    </button>

                    <a asp-action="Index"
                       asp-route-productId="@productId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageInput = document.getElementById("imageInput");
        const imagePreview = document.getElementById("imagePreview");

        imageInput.addEventListener("change", function () {

            const file = this.files[0];

            if (!file) {
                imagePreview.classList.add("d-none");
                return;
            }

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            if (!allowedTypes.includes(file.type)) {
                alert("Please select a valid image.");
                this.value = "";
                imagePreview.classList.add("d-none");
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert("Image size cannot exceed 5 MB.");
                this.value = "";
                imagePreview.classList.add("d-none");
                return;
            }

            const reader = new FileReader();

            reader.onload = function (e) {
                imagePreview.src = e.target.result;
                imagePreview.classList.remove("d-none");
            };

            reader.readAsDataURL(file);
        });
    </script>
}
