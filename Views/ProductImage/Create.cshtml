@model Veltrix.DTOs.ProductImageDTO.CreateProductImageDto

@{
    ViewData["Title"] = "Upload Product Image";
    var productId = (int)ViewBag.ProductId;
}

<div class="container-fluid products-page product-image-form-page">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Upload Product Image</h2>
            <p class="text-muted mb-0">
                Add a new image to your product gallery.
            </p>
        </div>

        <a asp-action="Index"
           asp-route-productId="@productId"
           class="vx-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Gallery
        </a>

    </div>

    <!-- Form Card -->
    <div class="card border-0 product-image-form-card">

        <div class="card-body p-4">

            <form asp-action="Create"
                  asp-route-productId="@productId"
                  method="post"
                  enctype="multipart/form-data"
                  id="createProductImageForm">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="row g-4">

                    <!-- Image Upload -->
                    <div class="col-lg-7">

                        <label asp-for="Image" class="form-label fw-semibold">
                            Product Image <span class="text-danger">*</span>
                        </label>

                        <div class="product-image-upload-area" id="uploadArea">

                            <input asp-for="Image"
                                   type="file"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                   class="form-control"
                                   id="imageInput" />

                            <div class="product-upload-placeholder" id="uploadPlaceholder">

                                <i class="bi bi-cloud-arrow-up"></i>

                                <h6>Choose an image to upload</h6>

                                <p class="text-muted small mb-2">
                                    JPG, JPEG, PNG or WEBP
                                </p>

                                <span class="product-upload-limit">
                                    Maximum file size: 5 MB
                                </span>

                            </div>

                            <div class="product-upload-preview d-none" id="previewContainer">

                                <img id="imagePreview"
                                     src=""
                                     alt="Selected image preview" />

                                <button type="button"
                                        id="removeImageButton"
                                        class="product-remove-preview"
                                        title="Remove selected image">
                                    <i class="bi bi-x-lg"></i>
                                </button>

                                <div class="product-preview-info">
                                    <span id="fileName"></span>
                                    <span id="fileSize"></span>
                                </div>

                            </div>

                        </div>

                        <span asp-validation-for="Image"
                              class="text-danger small"></span>

                        <div class="product-upload-error d-none"
                             id="uploadError"
                             role="alert"></div>

                    </div>

                    <!-- Image Settings -->
                    <div class="col-lg-5">

                        <div class="product-image-settings">

                            <h6 class="fw-semibold mb-3">
                                <i class="bi bi-sliders me-2"></i>
                                Image Settings
                            </h6>

                            <div class="mb-4">

                                <label asp-for="AltText" class="form-label">
                                    Alternative Text
                                </label>

                                <input asp-for="AltText"
                                       class="form-control"
                                       maxlength="300"
                                       placeholder="Describe the product image..." />

                                <span asp-validation-for="AltText"
                                      class="text-danger small"></span>

                                <div class="form-text">
                                    Helps accessibility and image understanding.
                                </div>

                            </div>

                            <div class="product-primary-option">

                                <div>
                                    <label asp-for="IsPrimary"
                                           class="fw-semibold mb-1">
                                        Primary Image
                                    </label>

                                    <p class="text-muted small mb-0">
                                        Use this as the main product image.
                                    </p>
                                </div>

                                <div class="form-check form-switch">
                                    <input asp-for="IsPrimary"
                                           class="form-check-input"
                                           role="switch" />
                                </div>

                            </div>

                            <div class="product-image-hint mt-4">
                                <i class="bi bi-info-circle me-2"></i>
                                The first uploaded image is automatically
                                assigned as the primary image.
                            </div>

                        </div>

                    </div>

                </div>

                <!-- Actions -->
                <div class="product-image-form-actions mt-4 pt-3">

                    <a asp-action="Index"
                       asp-route-productId="@productId"
                       class="vx-btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="vx-btn-primary"
                            id="uploadSubmitButton">
                        <i class="bi bi-cloud-arrow-up"></i>
                        Upload Image
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const imageInput = document.getElementById("imageInput");
            const previewContainer = document.getElementById("previewContainer");
            const uploadPlaceholder = document.getElementById("uploadPlaceholder");
            const imagePreview = document.getElementById("imagePreview");
            const removeButton = document.getElementById("removeImageButton");
            const uploadError = document.getElementById("uploadError");
            const fileName = document.getElementById("fileName");
            const fileSize = document.getElementById("fileSize");
            const form = document.getElementById("createProductImageForm");

            const maxFileSize = 5 * 1024 * 1024;
            const allowedExtensions = [".jpg", ".jpeg", ".png", ".webp"];

            let previewUrl = null;

            function showError(message) {
                uploadError.textContent = message;
                uploadError.classList.remove("d-none");
            }

            function clearError() {
                uploadError.textContent = "";
                uploadError.classList.add("d-none");
            }

            function removePreview() {

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                    previewUrl = null;
                }

                imageInput.value = "";
                imagePreview.src = "";

                previewContainer.classList.add("d-none");
                uploadPlaceholder.classList.remove("d-none");

                fileName.textContent = "";
                fileSize.textContent = "";

                clearError();
            }

            imageInput.addEventListener("change", function () {

                clearError();

                const file = this.files[0];

                if (!file) {
                    removePreview();
                    return;
                }

                const extension = file.name.substring(
                    file.name.lastIndexOf(".")
                ).toLowerCase();

                if (!allowedExtensions.includes(extension)) {
                    showError("Unsupported image format. Use JPG, JPEG, PNG or WEBP.");
                    removePreview();
                    return;
                }

                if (file.size > maxFileSize) {
                    showError("Image size cannot exceed 5 MB.");
                    removePreview();
                    return;
                }

                if (file.size === 0) {
                    showError("The selected image is empty.");
                    removePreview();
                    return;
                }

                previewUrl = URL.createObjectURL(file);

                imagePreview.src = previewUrl;
                fileName.textContent = file.name;
                fileSize.textContent =
                    (file.size / (1024 * 1024)).toFixed(2) + " MB";

                uploadPlaceholder.classList.add("d-none");
                previewContainer.classList.remove("d-none");

            });

            removeButton.addEventListener("click", removePreview);

            form.addEventListener("submit", function (event) {

                clearError();

                const file = imageInput.files[0];

                if (!file) {
                    event.preventDefault();
                    showError("Please select an image before uploading.");
                    return;
                }

                const extension = file.name.substring(
                    file.name.lastIndexOf(".")
                ).toLowerCase();

                if (!allowedExtensions.includes(extension) ||
                    file.size === 0 ||
                    file.size > maxFileSize) {

                    event.preventDefault();
                    showError("Please select a valid image not exceeding 5 MB.");
                }

            });

            window.addEventListener("beforeunload", function () {
                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                }
            });

        });
    </script>
}
