@model IReadOnlyList<Veltrix.DTOs.VariantOptionsDTO.VariantOptionsDto>

@{
    ViewData["Title"] = "Variant Options";
    var productId = (int)ViewBag.ProductId;
}

<div class="vx-page">

    <div class="vx-page-header">
        <div>
            <h1 class="vx-page-title">Variant Options</h1>
            <p class="vx-page-subtitle">
                Manage the option groups available for this product's variants.
            </p>
        </div>

        <div class="vx-page-actions">
            <a asp-controller="ProductVariant"
               asp-action="Index"
               asp-route-productId="@productId"
               class="vx-btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Back to Variants
            </a>

            <a asp-action="Create"
               asp-route-productId="@productId"
               class="vx-btn-primary">
                <i class="bi bi-plus-lg"></i>
                Add Option Group
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="vx-alert vx-alert-success">
            <i class="bi bi-check-circle"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="vx-alert vx-alert-danger">
            <i class="bi bi-exclamation-circle"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="vx-options-summary">
        <div class="vx-option-summary-card">
            <div class="vx-option-summary-icon">
                <i class="bi bi-ui-checks-grid"></i>
            </div>
            <div>
                <span>Total Option Groups</span>
                <strong>@Model.Count</strong>
            </div>
        </div>

        <div class="vx-option-summary-card">
            <div class="vx-option-summary-icon">
                <i class="bi bi-list-check"></i>
            </div>
            <div>
                <span>Total Option Values</span>
                <strong>@Model.Sum(x => x.Values.Count)</strong>
            </div>
        </div>
    </div>

    <div class="vx-content-card">

        <div class="vx-section-header">
            <div>
                <h2>Option Groups</h2>
                <p>
                    Each group represents an attribute that can distinguish product variants.
                </p>
            </div>

            <span class="vx-count-badge">@Model.Count</span>
        </div>

        @if (Model.Any())
        {
            <div class="vx-option-groups-grid">

                @foreach (var option in Model.OrderBy(x => x.DisplayOrder).ThenBy(x => x.Id))
                {
                    <div class="vx-option-group-card">

                        <div class="vx-option-group-header">
                            <div class="vx-option-group-heading">
                                <div class="vx-option-group-icon">
                                    <i class="bi bi-tags"></i>
                                </div>

                                <div>
                                    <h3>@option.Name</h3>
                                    <span>Group #@option.Id</span>
                                </div>
                            </div>

                            <span class="vx-option-order">
                                Order @option.DisplayOrder
                            </span>
                        </div>

                        <div class="vx-option-values-section">
                            <div class="vx-option-values-heading">
                                <span>Available Values</span>
                                <span class="vx-values-count">
                                    @option.Values.Count
                                </span>
                            </div>

                            @if (option.Values.Any())
                            {
                                <div class="vx-option-value-list">
                                    @foreach (var value in option.Values
                                                            .OrderBy(x => x.DisplayOrder)
                                                            .ThenBy(x => x.Id))
                                    {
                                        <span class="vx-option-value-chip"
                                              title="Display order: @value.DisplayOrder">
                                            @value.Value
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="vx-no-option-values">
                                    <i class="bi bi-info-circle"></i>
                                    No values added to this group yet.
                                </div>
                            }
                        </div>

                        <div class="vx-option-group-footer">

                            <a asp-controller="VariantOptionValues"
                               asp-action="Index"
                               asp-route-groupId="@option.Id"
                               class="vx-manage-values-link">
                                <i class="bi bi-list-check"></i>
                                Manage Values
                            </a>

                            <div class="vx-option-group-actions">

                                <a asp-action="Edit"
                                   asp-route-id="@option.Id"
                                   asp-route-productId="@productId"
                                   class="vx-icon-action"
                                   title="Edit option group">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@option.Id"
                                      asp-route-productId="@productId"
                                      method="post"
                                      class="vx-inline-form"
                                      onsubmit="return confirm('Delete this option group? This is only allowed when it has no values.');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="vx-icon-action vx-delete-action"
                                            title="Delete option group">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>

                            </div>
                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="vx-empty-state">
                <div class="vx-empty-icon">
                    <i class="bi bi-ui-checks-grid"></i>
                </div>

                <h3>No option groups yet</h3>

                <p>
                    Create option groups such as Color, Size, or Material
                    to define the available product variants.
                </p>

                <a asp-action="Create"
                   asp-route-productId="@productId"
                   class="vx-btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Create First Option Group
                </a>
            </div>
        }

    </div>
</div>
