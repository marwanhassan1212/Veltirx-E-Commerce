@model Veltrix.DTOs.VariantOptionsDTO.UpdateVariantOptionsDto

@{
    ViewData["Title"] = "Edit Option Group";
    var productId = (int)ViewBag.ProductId;
    var optionId = (int)ViewBag.OptionId;
}

<div class="vx-page">

    <div class="vx-page-header">
        <div>
            <h1 class="vx-page-title">Edit Option Group</h1>
            <p class="vx-page-subtitle">
                Update the name of this product option group.
            </p>
        </div>

        <a asp-action="Index"
           asp-route-productId="@productId"
           class="vx-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Options
        </a>
    </div>

    <div class="vx-form-layout">

        <div class="vx-content-card">

            <div class="vx-section-header">
                <div>
                    <h2>Option Group Information</h2>
                    <p>Update the group name below.</p>
                </div>

                <span class="vx-count-badge">#@optionId</span>
            </div>

            <form asp-action="Edit"
                  asp-route-id="@optionId"
                  asp-route-productId="@productId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="vx-validation-summary"></div>

                <div class="vx-form-group">
                    <label asp-for="Name" class="vx-form-label">
                        Group Name <span class="vx-required">*</span>
                    </label>

                    <input asp-for="Name"
                           class="vx-form-control"
                           placeholder="e.g. Color, Size, Material"
                           maxlength="100"
                           autocomplete="off" />

                    <span asp-validation-for="Name"
                          class="vx-field-error"></span>

                    <small class="vx-form-hint">
                        The new name must be unique within this product.
                    </small>
                </div>

                <div class="vx-form-footer">
                    <a asp-action="Index"
                       asp-route-productId="@productId"
                       class="vx-btn-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="vx-btn-primary">
                        <i class="bi bi-check-lg"></i>
                        Save Changes
                    </button>
                </div>

            </form>
        </div>

        <aside class="vx-content-card vx-form-aside">

            <div class="vx-aside-icon">
                <i class="bi bi-info-circle"></i>
            </div>

            <h3>Important Information</h3>

            <ul class="vx-guidelines-list">
                <li>
                    <i class="bi bi-check2"></i>
                    The new name must be unique for this product.
                </li>
                <li>
                    <i class="bi bi-check2"></i>
                    Existing option values will remain unchanged.
                </li>
                <li>
                    <i class="bi bi-check2"></i>
                    The display order is preserved automatically.
                </li>
                <li>
                    <i class="bi bi-check2"></i>
                    Existing variant selections remain linked to this group.
                </li>
            </ul>

        </aside>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
