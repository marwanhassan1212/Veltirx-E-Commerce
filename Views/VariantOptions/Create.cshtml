@model Veltrix.DTOs.VariantOptionsDTO.CreateVariantOptionsDto

@{
    ViewData["Title"] = "Create Option Group";
    var productId = Model.ProductId;
}

<div class="vx-page">

    <div class="vx-page-header">
        <div>
            <h1 class="vx-page-title">Create Option Group</h1>
            <p class="vx-page-subtitle">
                Add a new attribute to distinguish product variants.
            </p>
        </div>

        <a asp-action="Index"
           asp-route-productId="@productId"
           class="vx-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Options
        </a>
    </div>

    <div class="vx-form-layout">

        <div class="vx-content-card">

            <div class="vx-section-header">
                <div>
                    <h2>Option Group Information</h2>
                    <p>Enter the name of the new option group.</p>
                </div>
            </div>

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="ProductId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="vx-validation-summary"></div>

                <div class="vx-form-group">
                    <label asp-for="Name" class="vx-form-label">
                        Group Name <span class="vx-required">*</span>
                    </label>

                    <input asp-for="Name"
                           class="vx-form-control"
                           placeholder="e.g. Color, Size, Material"
                           maxlength="100"
                           autocomplete="off" />

                    <span asp-validation-for="Name"
                          class="vx-field-error"></span>

                    <small class="vx-form-hint">
                        Use a clear name that describes the product attribute.
                    </small>
                </div>

                <div class="vx-form-footer">
                    <a asp-action="Index"
                       asp-route-productId="@productId"
                       class="vx-btn-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="vx-btn-primary">
                        <i class="bi bi-plus-lg"></i>
                        Create Option Group
                    </button>
                </div>

            </form>
        </div>

        <aside class="vx-content-card vx-form-aside">

            <div class="vx-aside-icon">
                <i class="bi bi-lightbulb"></i>
            </div>

            <h3>Examples</h3>

            <p class="vx-aside-description">
                Option groups describe the attributes that differentiate variants.
            </p>

            <div class="vx-option-example">
                <strong>Color</strong>
                <div>
                    <span>Black</span>
                    <span>White</span>
                    <span>Blue</span>
                </div>
            </div>

            <div class="vx-option-example">
                <strong>Size</strong>
                <div>
                    <span>Small</span>
                    <span>Medium</span>
                    <span>Large</span>
                </div>
            </div>

            <div class="vx-option-example">
                <strong>Material</strong>
                <div>
                    <span>Cotton</span>
                    <span>Leather</span>
                </div>
            </div>

            <p class="vx-aside-note">
                After creating a group, add its available values from the Manage Values page.
            </p>

        </aside>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
