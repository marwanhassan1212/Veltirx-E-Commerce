@using Veltrix.DTOs.ShipmentDTO
@using Veltrix.DTOs.ShipmentTrackingEventDTO
@model ShipmentDto

@{
    ViewData["Title"] = "Track Shipment";

    var events = ViewBag.TrackingEvents as IEnumerable<ShipmentTrackingEventDto>
                 ?? Enumerable.Empty<ShipmentTrackingEventDto>();
}

<div class="admin-shipment-page">

    <div class="shipment-page-header">
        <div>
            <h2>Track Shipment</h2>
            <p>Find a shipment using its tracking number.</p>
        </div>
    </div>

    <div class="shipment-card shipment-search-card">

        <div class="shipment-search-icon">
            <i class="bi bi-search"></i>
        </div>

        <h5>Where is your shipment?</h5>
        <p>Enter the tracking number to view the latest shipment information.</p>

        <form asp-action="Track" method="get" class="shipment-search-form">

            <input type="text"
                   name="trackingNumber"
                   value="@Model.TrackingNumber"
                   placeholder="Enter tracking number..."
                   required />

            <button type="submit" class="shipment-btn shipment-btn-primary">
                <i class="bi bi-search"></i>
                Track
            </button>

        </form>

    </div>

    <div class="shipment-card">

        <div class="shipment-card-header">
            <div>
                <h5>Shipment Result</h5>
                <p>Current information for the requested tracking number.</p>
            </div>

            <span class="shipment-status">
                @Model.status
            </span>
        </div>

        <div class="shipment-info-grid">

            <div class="shipment-info-item">
                <span>Tracking Number</span>
                <strong>@Model.TrackingNumber</strong>
            </div>

            <div class="shipment-info-item">
                <span>Shipment Status</span>
                <strong>@Model.status</strong>
            </div>

            <div class="shipment-info-item">
                <span>Carrier</span>
                <strong>@(Model.CarrierName ?? "Not specified")</strong>
            </div>

            <div class="shipment-info-item">
                <span>Order Reference</span>
                <strong>#@Model.OrderId</strong>
            </div>

            <div class="shipment-info-item">
                <span>Shipped At</span>
                <strong>
                    @(Model.ShippedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Not shipped")
                </strong>
            </div>

            <div class="shipment-info-item">
                <span>Estimated Delivery</span>
                <strong>
                    @(Model.EstimatedDeliveryAt?.ToString("dd MMM yyyy") ?? "Not available")
                </strong>
            </div>

            <div class="shipment-info-item">
                <span>Delivered At</span>
                <strong>
                    @(Model.DeliveredAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Not delivered")
                </strong>
            </div>

        </div>

    </div>

    <div class="shipment-card">

        <div class="shipment-card-header">
            <div>
                <h5>Tracking Updates</h5>
                <p>Shipment movement and status history.</p>
            </div>

            <span class="shipment-count">
                @events.Count() Events
            </span>
        </div>

        <div class="shipment-timeline">

            @if (events.Any())
            {
                foreach (var trackingEvent in events.OrderByDescending(x => x.OccurredAt))
                {
                    <div class="shipment-timeline-item">

                        <div class="shipment-timeline-marker">
                            <i class="bi bi-circle-fill"></i>
                        </div>

                        <div class="shipment-timeline-content">

                            <div class="shipment-timeline-heading">
                                <strong>@trackingEvent.Status</strong>
                                <span>
                                    @trackingEvent.OccurredAt.ToString("dd MMM yyyy, hh:mm tt")
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(trackingEvent.Description))
                            {
                                <p>@trackingEvent.Description</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(trackingEvent.Location))
                            {
                                <small>
                                    <i class="bi bi-geo-alt"></i>
                                    @trackingEvent.Location
                                </small>
                            }

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="shipment-empty-state">
                    <i class="bi bi-clock-history"></i>
                    <h6>No tracking updates yet</h6>
                    <p>No tracking events have been recorded for this shipment.</p>
                </div>
            }

        </div>

    </div>

</div>