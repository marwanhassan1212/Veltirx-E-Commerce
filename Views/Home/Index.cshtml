@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p>Here's what's happening with your store today.</p>
    </div>

    <button class="btn btn-dark export-btn">
        <i class="bi bi-download me-2"></i>
        Export Report
    </button>
</div>

<!-- Statistics -->

<div class="row g-3 mb-4">

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <span>Total Revenue</span>
                <div class="stat-icon revenue-icon">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>

            <h3>EGP 128,450</h3>

            <div class="stat-bottom">
                <span class="positive">
                    <i class="bi bi-arrow-up-right"></i> 12.8%
                </span>
                <span>vs last month</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <span>Total Orders</span>
                <div class="stat-icon orders-icon">
                    <i class="bi bi-bag"></i>
                </div>
            </div>

            <h3>1,284</h3>

            <div class="stat-bottom">
                <span class="positive">
                    <i class="bi bi-arrow-up-right"></i> 8.4%
                </span>
                <span>vs last month</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <span>Total Customers</span>
                <div class="stat-icon customers-icon">
                    <i class="bi bi-people"></i>
                </div>
            </div>

            <h3>856</h3>

            <div class="stat-bottom">
                <span class="positive">
                    <i class="bi bi-arrow-up-right"></i> 5.2%
                </span>
                <span>vs last month</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <span>Pending Orders</span>
                <div class="stat-icon pending-icon">
                    <i class="bi bi-clock"></i>
                </div>
            </div>

            <h3>42</h3>

            <div class="stat-bottom">
                <span class="neutral">Needs attention</span>
            </div>
        </div>
    </div>

</div>

<!-- Sales Chart -->

<div class="row g-3 mb-4">

    <div class="col-12 col-xl-8">

        <div class="content-card h-100">

            <div class="card-heading">
                <div>
                    <h5>Sales Overview</h5>
                    <p>Revenue performance over time</p>
                </div>

                <select class="form-select period-select">
                    <option>Last 7 days</option>
                    <option>Last 30 days</option>
                    <option>Last 12 months</option>
                </select>
            </div>

            <div class="chart-container">
                <canvas id="salesChart"></canvas>
            </div>

        </div>

    </div>

    <div class="col-12 col-xl-4">

        <div class="content-card h-100">

            <div class="card-heading">
                <div>
                    <h5>Order Summary</h5>
                    <p>Current order distribution</p>
                </div>
            </div>

            <div class="chart-container summary-chart">
                <canvas id="ordersChart"></canvas>
            </div>

            <div class="order-legend">
                <div><span class="legend-dot delivered"></span> Delivered <strong>68%</strong></div>
                <div><span class="legend-dot processing"></span> Processing <strong>22%</strong></div>
                <div><span class="legend-dot cancelled"></span> Cancelled <strong>10%</strong></div>
            </div>

        </div>

    </div>

</div>

<!-- Recent Orders -->

<div class="content-card mb-4">

    <div class="card-heading">
        <div>
            <h5>Recent Orders</h5>
            <p>Latest transactions from your store</p>
        </div>

        <a href="#" class="view-all">View all orders <i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="table-responsive">

        <table class="table admin-table align-middle">

            <thead>
                <tr>
                    <th>ORDER ID</th>
                    <th>CUSTOMER</th>
                    <th>DATE</th>
                    <th>AMOUNT</th>
                    <th>PAYMENT</th>
                    <th>STATUS</th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td class="order-id">#VX-1042</td>
                    <td>Ahmed Mohamed</td>
                    <td>Nov 10, 2026</td>
                    <td>EGP 2,450</td>
                    <td>Cash on Delivery</td>
                    <td><span class="status-badge status-delivered">Delivered</span></td>
                </tr>

                <tr>
                    <td class="order-id">#VX-1041</td>
                    <td>Omar Ali</td>
                    <td>Nov 10, 2026</td>
                    <td>EGP 1,800</td>
                    <td>Cash on Delivery</td>
                    <td><span class="status-badge status-processing">Processing</span></td>
                </tr>

                <tr>
                    <td class="order-id">#VX-1040</td>
                    <td>Mohamed Hassan</td>
                    <td>Nov 09, 2026</td>
                    <td>EGP 3,200</td>
                    <td>Cash on Delivery</td>
                    <td><span class="status-badge status-pending">Pending</span></td>
                </tr>

                <tr>
                    <td class="order-id">#VX-1039</td>
                    <td>Ali Mahmoud</td>
                    <td>Nov 09, 2026</td>
                    <td>EGP 950</td>
                    <td>Cash on Delivery</td>
                    <td><span class="status-badge status-cancelled">Cancelled</span></td>
                </tr>

            </tbody>

        </table>

    </div>

</div>

<!-- Bottom Section -->

<div class="row g-3">

    <div class="col-12 col-xl-6">

        <div class="content-card">
            <div class="card-heading">
                <div>
                    <h5>Inventory Alerts</h5>
                    <p>Products that need your attention</p>
                </div>
                <a href="#" class="view-all">View inventory</a>
            </div>

            <div class="inventory-item">
                <div>
                    <strong>Wireless Headphones</strong>
                    <span>SKU: WH-001</span>
                </div>
                <span class="stock-low">5 units left</span>
            </div>

            <div class="inventory-item">
                <div>
                    <strong>Smart Watch Pro</strong>
                    <span>SKU: SW-002</span>
                </div>
                <span class="stock-low">3 units left</span>
            </div>

            <div class="inventory-item">
                <div>
                    <strong>USB-C Charger</strong>
                    <span>SKU: UC-003</span>
                </div>
                <span class="stock-low">8 units left</span>
            </div>
        </div>

    </div>

    <div class="col-12 col-xl-6">

        <div class="content-card">
            <div class="card-heading">
                <div>
                    <h5>Store Activity</h5>
                    <p>Recent administrative activity</p>
                </div>
            </div>

            <div class="activity-item">
                <div class="activity-icon"><i class="bi bi-bag-check"></i></div>
                <div>
                    <strong>New order received</strong>
                    <p>Order #VX-1042 was placed.</p>
                    <small>15 minutes ago</small>
                </div>
            </div>

            <div class="activity-item">
                <div class="activity-icon"><i class="bi bi-box-seam"></i></div>
                <div>
                    <strong>Product stock updated</strong>
                    <p>Wireless Headphones inventory changed.</p>
                    <small>1 hour ago</small>
                </div>
            </div>

            <div class="activity-item">
                <div class="activity-icon"><i class="bi bi-truck"></i></div>
                <div>
                    <strong>Shipment dispatched</strong>
                    <p>Shipment for #VX-1038 was dispatched.</p>
                    <small>3 hours ago</small>
                </div>
            </div>
        </div>

    </div>

</div>
