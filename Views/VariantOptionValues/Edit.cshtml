@model Veltrix.DTOs.VariantOptionValueDTO.UpdateVariantOptionValueDto

@{
    ViewData["Title"] = "Edit Option Value";

    int groupId = (int)ViewBag.GroupId;
    int valueId = (int)ViewBag.ValueId;
}

<div class="vx-page">

    <div class="vx-page-header">
        <div>
            <h1 class="vx-page-title">Edit Option Value</h1>
            <p class="vx-page-subtitle">
                Update the selected option value.
            </p>
        </div>

        <a asp-controller="VariantOptionValues"
           asp-action="Index"
           asp-route-groupId="@groupId"
           class="vx-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Values
        </a>
    </div>

    <div class="vx-form-layout">

        <div class="vx-content-card vx-form-main">

            <div class="vx-section-header">
                <div>
                    <h3>Edit Value Information</h3>
                    <p>Modify the value details below.</p>
                </div>

                <span class="vx-count-badge">
                    Value #@valueId
                </span>
            </div>

            <form asp-controller="VariantOptionValues"
                  asp-action="Edit"
                  asp-route-id="@valueId"
                  asp-route-groupId="@groupId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="vx-validation-summary"></div>

                <div class="vx-form-group">
                    <label asp-for="Value" class="vx-form-label">
                        Option Value <span class="vx-required">*</span>
                    </label>

                    <input asp-for="Value"
                           class="vx-form-control"
                           placeholder="Enter option value"
                           maxlength="100"
                           autofocus />

                    <span asp-validation-for="Value"
                          class="vx-field-error"></span>

                    <small class="vx-form-hint">
                        The new value must be unique within its option group.
                    </small>
                </div>

                <div class="vx-form-footer">
                    <a asp-controller="VariantOptionValues"
                       asp-action="Index"
                       asp-route-groupId="@groupId"
                       class="vx-btn-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="vx-btn-primary">
                        <i class="bi bi-check-lg"></i>
                        Save Changes
                    </button>
                </div>

            </form>
        </div>

        <aside class="vx-form-aside">
            <div class="vx-aside-icon">
                <i class="bi bi-pencil-square"></i>
            </div>

            <h3>Editing Information</h3>

            <p class="vx-aside-description">
                You are editing an existing option value.
            </p>

            <ul class="vx-guidelines-list">
                <li>Keep the value relevant to its option group.</li>
                <li>Duplicate values are not allowed.</li>
                <li>Display order is preserved automatically.</li>
                <li>Changes may affect the variants using this value.</li>
            </ul>

            <div class="vx-aside-note">
                <i class="bi bi-info-circle"></i>
                Make sure the updated value still accurately describes the variant option.
            </div>
        </aside>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
