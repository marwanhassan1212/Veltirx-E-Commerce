@model IReadOnlyList<Veltrix.DTOs.VariantOptionValueDTO.VariantOptionValueDto>

@{
    ViewData["Title"] = "Option Values";

    int groupId = (int)ViewBag.GroupId;
}

<div class="vx-page">

    <div class="vx-page-header">
        <div>
            <h1 class="vx-page-title">Option Values</h1>
            <p class="vx-page-subtitle">
                Manage the available values for this option group.
            </p>
        </div>

        <a asp-controller="VariantOptionValues"
           asp-action="Create"
           asp-route-groupId="@groupId"
           class="vx-btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Value
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="vx-alert vx-alert-success">
            <i class="bi bi-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="vx-alert vx-alert-danger">
            <i class="bi bi-exclamation-circle"></i>
            @TempData["Error"]
        </div>
    }

    <div class="vx-options-summary">
        <div class="vx-option-summary-card">
            <div class="vx-option-summary-icon">
                <i class="bi bi-list-check"></i>
            </div>

            <div>
                <span class="vx-summary-label">Total Values</span>
                <strong>@Model.Count</strong>
            </div>
        </div>

        <div class="vx-option-summary-card">
            <div class="vx-option-summary-icon">
                <i class="bi bi-diagram-3"></i>
            </div>

            <div>
                <span class="vx-summary-label">Option Group ID</span>
                <strong>#@groupId</strong>
            </div>
        </div>
    </div>

    <div class="vx-content-card">

        <div class="vx-section-header">
            <div>
                <h3>Available Values</h3>
                <p>Values that can be assigned to product variants.</p>
            </div>

            <span class="vx-count-badge">
                @Model.Count values
            </span>
        </div>

        @if (Model.Any())
        {
            <div class="vx-option-values-table-wrapper">
                <table class="vx-table">
                    <thead>
                        <tr>
                            <th>Value</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.OrderBy(x => x.DisplayOrder))
                        {
                            <tr>
                                <td>
                                    <div class="vx-value-name">
                                        <span class="vx-value-dot"></span>
                                        <strong>@item.Value</strong>
                                    </div>
                                </td>

                                <td>
                                    <div class="vx-table-actions">

                                        <a asp-controller="VariantOptionValues"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           asp-route-groupId="@groupId"
                                           class="vx-icon-action"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-controller="VariantOptionValues"
                                              asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              asp-route-groupId="@groupId"
                                              method="post"
                                              class="vx-inline-form"
                                              onsubmit="return confirm('Are you sure you want to delete this value?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="vx-icon-action vx-delete-action"
                                                    title="Delete">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="vx-empty-state">
                <div class="vx-empty-icon">
                    <i class="bi bi-list-ul"></i>
                </div>

                <h3>No values yet</h3>

                <p>
                    This option group does not have any values.
                    Add your first value to make it available for product variants.
                </p>

                <a asp-controller="VariantOptionValues"
                   asp-action="Create"
                   asp-route-groupId="@groupId"
                   class="vx-btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Add First Value
                </a>
            </div>
        }

    </div>

</div>
