@model Veltrix.DTOs.ProductVariantDTO.CreateProductVariantDto

@{
    ViewData["Title"] = "Create Variant";
    var productId = (int)ViewBag.ProductId;
}

<div class="container-fluid products-page product-variant-form-page">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Create Variant</h2>
            <p class="text-muted mb-0">
                Add a new SKU and price for this product.
            </p>
        </div>

        <a asp-action="Index"
           asp-route-productId="@productId"
           class="vx-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Variants
        </a>

    </div>

    <div class="card border-0 variant-form-card">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <input asp-for="ProductId" type="hidden" />

                <div class="row g-4">

                    <div class="col-lg-7">

                        <div class="mb-4">
                            <label asp-for="SKU" class="form-label">
                                SKU <span class="text-danger">*</span>
                            </label>

                            <input asp-for="SKU"
                                   class="form-control"
                                   maxlength="50"
                                   placeholder="Example: TSHIRT-BLK-M"
                                   autocomplete="off" />

                            <span asp-validation-for="SKU"
                                  class="text-danger small"></span>

                            <div class="form-text">
                                Enter a unique SKU for this product variant.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Price" class="form-label">
                                Price <span class="text-danger">*</span>
                            </label>

                            <div class="input-group">
                                <input asp-for="Price"
                                       type="number"
                                       class="form-control"
                                       min="0.01"
                                       max="9999999999999999.99"
                                       step="0.01"
                                       placeholder="0.00" />

                                <span class="input-group-text">EGP</span>
                            </div>

                            <span asp-validation-for="Price"
                                  class="text-danger small"></span>

                            <div class="form-text">
                                Price must be greater than zero.
                            </div>
                        </div>

                        <div class="variant-form-info">
                            <i class="bi bi-info-circle"></i>
                            <div>
                                <strong>Product #@productId</strong>
                                <p class="mb-0">
                                    This variant will be added to the selected product.
                                </p>
                            </div>
                        </div>

                    </div>

                    <div class="col-lg-5">

                        <div class="variant-form-side-panel">

                            <div class="variant-form-side-icon">
                                <i class="bi bi-box-seam"></i>
                            </div>

                            <h6>Variant Creation</h6>

                            <p>
                                Each variant has its own SKU and price.
                                You can assign product options after creating it.
                            </p>

                            <div class="variant-form-rule">
                                <i class="bi bi-star-fill"></i>
                                The first variant is automatically set as default.
                            </div>

                            <div class="variant-form-rule">
                                <i class="bi bi-list-check"></i>
                                Options can be assigned after creation.
                            </div>

                        </div>

                    </div>

                </div>

                <div class="variant-form-actions mt-4 pt-3">

                    <a asp-action="Index"
                       asp-route-productId="@productId"
                       class="vx-btn-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="vx-btn-primary">
                        <i class="bi bi-plus-lg"></i>
                        Create Variant
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>
