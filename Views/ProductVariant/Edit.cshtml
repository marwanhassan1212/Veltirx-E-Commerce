@model Veltrix.DTOs.ProductVariantDTO.UpdateProductVariantDto

@{
    ViewData["Title"] = "Edit Variant";

    var variantId = (int)ViewBag.VariantId;
    var productId = (int)ViewBag.ProductId;
}

<div class="container-fluid products-page product-variant-form-page">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Edit Variant</h2>
            <p class="text-muted mb-0">
                Update the SKU or price of this variant.
            </p>
        </div>

        <a asp-action="Index"
           asp-route-productId="@productId"
           class="vx-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Variants
        </a>

    </div>

    <div class="card border-0 variant-form-card">

        <div class="card-body p-4">

            <form asp-action="Edit"
                  asp-route-id="@variantId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="row g-4">

                    <div class="col-lg-7">

                        <div class="mb-4">
                            <label asp-for="SKU" class="form-label">
                                SKU <span class="text-danger">*</span>
                            </label>

                            <input asp-for="SKU"
                                   class="form-control"
                                   maxlength="50"
                                   autocomplete="off" />

                            <span asp-validation-for="SKU"
                                  class="text-danger small"></span>

                        </div>

                        <div class="mb-4">
                            <label asp-for="Price" class="form-label">
                                Price <span class="text-danger">*</span>
                            </label>

                            <div class="input-group">
                                <input asp-for="Price"
                                       type="number"
                                       class="form-control"
                                       min="0.01"
                                       max="9999999999999999.99"
                                       step="0.01" />

                                <span class="input-group-text">EGP</span>
                            </div>

                            <span asp-validation-for="Price"
                                  class="text-danger small"></span>

                        </div>

                        <div class="variant-form-info">
                            <i class="bi bi-shield-check"></i>
                            <div>
                                <strong>Variant #@variantId</strong>
                                <p class="mb-0">
                                    Only SKU and price can be changed from this page.
                                </p>
                            </div>
                        </div>

                    </div>

                    <div class="col-lg-5">

                        <div class="variant-form-side-panel">

                            <div class="variant-form-side-icon">
                                <i class="bi bi-pencil-square"></i>
                            </div>

                            <h6>Editing Variant</h6>

                            <p>
                                Update the variant information carefully.
                                Its assigned options and default status will remain unchanged.
                            </p>

                            <div class="variant-form-rule">
                                <i class="bi bi-box"></i>
                                Product #@productId
                            </div>

                            <div class="variant-form-rule">
                                <i class="bi bi-upc-scan"></i>
                                Variant #@variantId
                            </div>

                        </div>

                    </div>

                </div>

                <div class="variant-form-actions mt-4 pt-3">

                    <a asp-action="Index"
                       asp-route-productId="@productId"
                       class="vx-btn-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="vx-btn-primary">
                        <i class="bi bi-check-lg"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>
