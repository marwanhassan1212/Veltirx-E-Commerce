@model Veltrix.DTOs.ProductVariantDTO.ProductVariantDto

@{
    ViewData["Title"] = "Variant Details";
}

<div class="container-fluid products-page product-variant-details-page">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Variant Details</h2>
            <p class="text-muted mb-0">
                Review variant information and selected options.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index"
               asp-route-productId="@Model.ProductId"
               class="vx-btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Back to Variants
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="vx-btn-primary">
                <i class="bi bi-pencil"></i>
                Edit Variant
            </a>
        </div>

    </div>

    <div class="row g-4">

        <!-- Main Information -->
        <div class="col-lg-7">

            <div class="card border-0 variant-details-card h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

                        <div>
                            <span class="text-muted small">SKU</span>
                            <h3 class="fw-bold mt-1 mb-0">@Model.SKU</h3>
                            <span class="text-muted small">
                                Variant #@Model.Id
                            </span>
                        </div>

                        <div class="d-flex flex-column gap-2 align-items-end">

                            @if (Model.IsDefault)
                            {
                                <span class="variant-default-badge">
                                    <i class="bi bi-star-fill"></i> Default Variant
                                </span>
                            }

                            @if (Model.IsActive)
                            {
                                <span class="variant-status active">
                                    <span></span> Active
                                </span>
                            }
                            else
                            {
                                <span class="variant-status inactive">
                                    <span></span> Inactive
                                </span>
                            }

                        </div>

                    </div>

                    <div class="variant-detail-price">
                        <span>Variant Price</span>
                        <h2>@Model.Price.ToString("N2")</h2>
                    </div>

                    <div class="row g-3 mt-3">

                        <div class="col-md-6">
                            <div class="variant-detail-info">
                                <span>Product ID</span>
                                <strong>#@Model.ProductId</strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="variant-detail-info">
                                <span>Variant ID</span>
                                <strong>#@Model.Id</strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="variant-detail-info">
                                <span>Created At</span>
                                <strong>@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") UTC</strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="variant-detail-info">
                                <span>Last Updated</span>
                                <strong>
                                    @(Model.UpdatedAt.HasValue
                                                                        ? Model.UpdatedAt.Value.ToString("dd MMM yyyy, hh:mm tt") + " UTC"
                                                                        : "Never updated")
                                </strong>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>

        <!-- Options -->
        <div class="col-lg-5">

            <div class="card border-0 variant-details-card h-100">

                <div class="card-header bg-white border-0 p-4 pb-0">
                    <h5 class="fw-bold mb-1">Selected Options</h5>
                    <p class="text-muted small mb-0">
                        Attributes assigned to this variant.
                    </p>
                </div>

                <div class="card-body p-4">

                    @if (Model.SelectedOptions.Any())
                    {
                        <div class="variant-details-options">

                            @foreach (var option in Model.SelectedOptions)
                            {
                                <div class="variant-details-option">
                                    <span>@option.OptionName</span>
                                    <strong>@option.Value</strong>
                                </div>
                            }

                        </div>

                        <a asp-action="EditOptions"
                           asp-route-id="@Model.Id"
                           class="vx-btn-secondary w-100 mt-4 justify-content-center">
                            <i class="bi bi-sliders"></i>
                            Edit Options
                        </a>
                    }
                    else
                    {
                        <div class="variant-no-options">
                            <i class="bi bi-list-check"></i>
                            <h6>No Options Assigned</h6>
                            <p>
                                Assign option values to describe this variant.
                            </p>

                            <a asp-action="SetOptions"
                               asp-route-id="@Model.Id"
                               class="vx-btn-primary">
                                <i class="bi bi-plus-lg"></i>
                                Assign Options
                            </a>
                        </div>
                    }

                </div>
            </div>

        </div>

    </div>

</div>
