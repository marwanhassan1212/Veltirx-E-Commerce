@model Veltrix.DTOs.ProductVariantDTO.SetVariantOptionsDto

@using Veltrix.Models

@{
    ViewData["Title"] = "Assign Variant Options";

    var variantId = (int)ViewBag.VariantId;
    var productId = (int)ViewBag.ProductId;

    var optionGroups =
        ViewBag.OptionGroups as IReadOnlyList<VariantOptions>
        ?? Array.Empty<VariantOptions>();
}

<div class="container-fluid products-page variant-options-page">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Assign Variant Options</h2>
            <p class="text-muted mb-0">
                Select one value from every option group.
            </p>
        </div>

        <a asp-action="Index"
           asp-route-productId="@productId"
           class="vx-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Variants
        </a>

    </div>

    <div class="card border-0 variant-options-card">

        <div class="card-body p-4">

            <form asp-action="SetOptions"
                  asp-route-id="@variantId"
                  method="post"
                  id="variantOptionsForm">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="variant-options-intro mb-4">
                    <div class="variant-options-intro-icon">
                        <i class="bi bi-sliders"></i>
                    </div>

                    <div>
                        <h6>Variant #@variantId</h6>
                        <p class="mb-0">
                            Product #@productId — Choose exactly one value
                            from each available group.
                        </p>
                    </div>
                </div>

                @if (optionGroups.Any())
                {
                    <div class="row g-4">

                        @foreach (var group in optionGroups.OrderBy(x => x.DisplayOrder))
                        {
                            <div class="col-lg-6">

                                <div class="variant-option-group-card"
                                     data-option-group="@group.Id">

                                    <div class="variant-option-group-header">
                                        <div>
                                            <h6>@group.Name</h6>
                                            <span>Select one value</span>
                                        </div>

                                        <span class="variant-option-required">
                                            Required
                                        </span>
                                    </div>

                                    <div class="variant-option-values">

                                        @foreach (var value in group.Values.OrderBy(x => x.DisplayOrder))
                                        {
                                            <label class="variant-option-choice">


                                                <input type="checkbox"
                                                       name="VariantOptionValueIds"
                                                       value="@value.Id"
                                                       data-group="@group.Id" />


                                                <span class="variant-option-choice-content">
                                                    @value.Value
                                                </span>

                                                <i class="bi bi-check-circle-fill"></i>

                                            </label>
                                        }

                                    </div>

                                    <div class="variant-option-group-error">
                                        Choose one value from this group.
                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                    <div class="variant-options-footer mt-4">

                        <div class="variant-options-help">
                            <i class="bi bi-info-circle"></i>
                            One value must be selected from every group.
                        </div>

                        <div class="d-flex gap-2 flex-wrap">

                            <a asp-action="Index"
                               asp-route-productId="@productId"
                               class="vx-btn-secondary">
                                Cancel
                            </a>

                            <button type="submit" class="vx-btn-primary">
                                <i class="bi bi-check-lg"></i>
                                Assign Options
                            </button>

                        </div>

                    </div>
                }
                else
                {
                    <div class="variant-empty-state">
                        <div class="variant-empty-icon">
                            <i class="bi bi-sliders"></i>
                        </div>

                        <h5>No Option Groups Available</h5>

                        <p>
                            Create option groups and values for this product
                            before assigning options to its variants.
                        </p>

                        <a asp-controller="VariantOptions"
                           asp-action="Index"
                           asp-route-productId="@productId"
                           class="vx-btn-primary">
                            <i class="bi bi-list-check"></i>
                            Manage Product Options
                        </a>
                    </div>
                }

            </form>

        </div>
    </div>

</div>


document.addEventListener("DOMContentLoaded", function () {

    const form = document.getElementById("variantOptionsForm");
    if (!form) return;

    const groups = form.querySelectorAll("[data-option-group]");

    groups.forEach(group => {

        const checkboxes = group.querySelectorAll(
            'input[type="checkbox"]'
        );

        checkboxes.forEach(checkbox => {

            checkbox.addEventListener("change", function () {

                if (this.checked) {
                    checkboxes.forEach(other => {
                        if (other !== this) {
                            other.checked = false;
                        }
                    });
                }

                group.classList.remove("has-error");
            });

        });
    });

    form.addEventListener("submit", function (event) {

        let valid = true;

        groups.forEach(group => {

            const selected = group.querySelectorAll(
                'input[type="checkbox"]:checked'
            );

            if (selected.length !== 1) {
                group.classList.add("has-error");
                valid = false;
            } else {
                group.classList.remove("has-error");
            }
        });

        if (!valid) {
            event.preventDefault();

            form.querySelector(".has-error")?.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
        }
    });
});
