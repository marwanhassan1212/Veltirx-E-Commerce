@model IReadOnlyList<Veltrix.DTOs.ProductVariantDTO.ProductVariantDto>

@{
    ViewData["Title"] = "Product Variants";

    var productId = (int)ViewBag.ProductId;

    var variants = Model
        .OrderByDescending(x => x.IsDefault)
        .ThenBy(x => x.Id)
        .ToList();

    var activeCount = variants.Count(x => x.IsActive);
    var inactiveCount = variants.Count(x => !x.IsActive);
    var defaultVariant = variants.FirstOrDefault(x => x.IsDefault);
}

<div class="container-fluid products-page product-variants-page">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Product Variants</h2>
            <p class="text-muted mb-0">
                Manage SKUs, prices, options and availability.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="ProductImage"
               asp-action="Index"
               asp-route-productId="@productId"
               class="vx-btn-secondary">
                <i class="bi bi-images"></i>
                Product Images
            </a>

            <a asp-controller="Product"
               asp-action="Index"
               class="vx-btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Back to Products
            </a>

            <a asp-action="Create"
               asp-route-productId="@productId"
               class="vx-btn-primary">
                <i class="bi bi-plus-lg"></i>
                Add Variant
            </a>

        </div>

    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Summary -->
    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="variant-stat-card">
                <div class="variant-stat-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <span>Total Variants</span>
                    <h4>@variants.Count</h4>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="variant-stat-card">
                <div class="variant-stat-icon variant-stat-active">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <span>Active Variants</span>
                    <h4>@activeCount</h4>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="variant-stat-card">
                <div class="variant-stat-icon variant-stat-inactive">
                    <i class="bi bi-pause-circle"></i>
                </div>
                <div>
                    <span>Inactive Variants</span>
                    <h4>@inactiveCount</h4>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="variant-stat-card">
                <div class="variant-stat-icon variant-stat-default">
                    <i class="bi bi-star"></i>
                </div>
                <div>
                    <span>Default Variant</span>
                    <h4 class="variant-stat-default-value">
                        @(defaultVariant?.SKU ?? "Not set")
                    </h4>
                </div>
            </div>
        </div>

    </div>

    <!-- Filters -->
    <div class="card border-0 variant-filter-card mb-4">
        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-lg-5">
                    <label for="variantSearch" class="form-label">
                        Search Variants
                    </label>
                    <div class="variant-search-box">
                        <i class="bi bi-search"></i>
                        <input type="text"
                               id="variantSearch"
                               class="form-control"
                               placeholder="Search by SKU or option..." />
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label for="variantStatusFilter" class="form-label">
                        Status
                    </label>
                    <select id="variantStatusFilter" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label for="variantDefaultFilter" class="form-label">
                        Default
                    </label>
                    <select id="variantDefaultFilter" class="form-select">
                        <option value="">All Variants</option>
                        <option value="default">Default Only</option>
                        <option value="regular">Non-default</option>
                    </select>
                </div>

                <div class="col-lg-1">
                    <button type="button"
                            id="clearVariantFilters"
                            class="vx-btn-secondary w-100"
                            title="Clear filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- Variants Table -->
    <div class="card border-0 variant-table-card">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1">Variants List</h5>
                    <p class="text-muted small mb-0">
                        Product #@productId
                    </p>
                </div>

                <span class="variant-total-badge">
                    @variants.Count Variants
                </span>
            </div>

        </div>

        @if (variants.Any())
        {
            <div class="table-responsive">

                <table class="table align-middle variant-table mb-0">

                    <thead>
                        <tr>
                            <th>Variant</th>
                            <th>Options</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Default</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="variantsTableBody">

                        @foreach (var variant in variants)
                        {
                            var optionSearch = string.Join(" ",
                            variant.SelectedOptions.Select(x =>
                            $"{x.OptionName} {x.Value}"));

                            <tr class="variant-table-row"
                                data-search="@($"{variant.SKU} {optionSearch}".ToLowerInvariant())"
                                data-status="@(variant.IsActive ? "active" : "inactive")"
                                data-default="@(variant.IsDefault ? "default" : "regular")">

                                <td>
                                    <div class="variant-main-info">
                                        <span class="variant-sku">
                                            @variant.SKU
                                        </span>
                                        <span class="variant-id">
                                            Variant #@variant.Id
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    @if (variant.SelectedOptions.Any())
                                    {
                                        <div class="variant-option-tags">
                                            @foreach (var option in variant.SelectedOptions)
                                            {
                                                <span class="variant-option-tag">
                                                    <strong>@option.OptionName:</strong>
                                                    @option.Value
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            No options assigned
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="variant-price">
                                        @variant.Price.ToString("N2")
                                    </span>
                                </td>

                                <td>
                                    @if (variant.IsActive)
                                    {
                                        <span class="variant-status active">
                                            <span></span> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="variant-status inactive">
                                            <span></span> Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (variant.IsDefault)
                                    {
                                        <span class="variant-default-badge">
                                            <i class="bi bi-star-fill"></i>
                                            Default
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>

                                <td>
                                    <div class="variant-actions">

                                        <a asp-action="Details"
                                           asp-route-id="@variant.Id"
                                           class="variant-action-btn"
                                           title="View details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@variant.Id"
                                           class="variant-action-btn"
                                           title="Edit variant">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (variant.SelectedOptions.Any())
                                        {
                                            <a asp-action="EditOptions"
                                               asp-route-id="@variant.Id"
                                               class="variant-action-btn"
                                               title="Edit options">
                                                <i class="bi bi-sliders"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="SetOptions"
                                               asp-route-id="@variant.Id"
                                               class="variant-action-btn"
                                               title="Assign options">
                                                <i class="bi bi-list-check"></i>
                                            </a>
                                        }

                                        @if (!variant.IsDefault && variant.IsActive)
                                        {
                                            <form asp-action="SetDefault"
                                                  asp-route-id="@variant.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Set this variant as the default variant?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="variant-action-btn variant-action-star"
                                                        title="Set as default">
                                                    <i class="bi bi-star"></i>
                                                </button>
                                            </form>
                                        }

                                        @if (variant.IsActive && !variant.IsDefault)
                                        {
                                            <form asp-action="Deactivate"
                                                  asp-route-id="@variant.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Deactivate this variant?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="variant-action-btn variant-action-warning"
                                                        title="Deactivate">
                                                    <i class="bi bi-pause-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        else if (!variant.IsActive)
                                        {
                                            <form asp-action="Activate"
                                                  asp-route-id="@variant.Id"
                                                  method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="variant-action-btn variant-action-success"
                                                        title="Activate">
                                                    <i class="bi bi-play-circle"></i>
                                                </button>
                                            </form>
                                        }

                                        @if (!variant.IsDefault)
                                        {
                                            <form asp-action="Delete"
                                                  asp-route-id="@variant.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this variant? This action cannot be undone.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="variant-action-btn variant-action-delete"
                                                        title="Delete">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div id="variantNoResults" class="variant-no-results d-none">
                <i class="bi bi-search"></i>
                <h6>No matching variants</h6>
                <p>Try changing your search or filters.</p>
            </div>
        }
        else
        {
            <div class="variant-empty-state">
                <div class="variant-empty-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <h5>No Variants Yet</h5>

                <p>
                    Create your first variant to manage different
                    product combinations and prices.
                </p>

                <a asp-action="Create"
                   asp-route-productId="@productId"
                   class="vx-btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Create First Variant
                </a>
            </div>
        }

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("variantSearch");
            const statusFilter = document.getElementById("variantStatusFilter");
            const defaultFilter = document.getElementById("variantDefaultFilter");
            const clearButton = document.getElementById("clearVariantFilters");
            const rows = document.querySelectorAll(".variant-table-row");
            const noResults = document.getElementById("variantNoResults");
            const tableBody = document.getElementById("variantsTableBody");

            if (!searchInput || !statusFilter || !defaultFilter) return;

            function applyFilters() {

                const search = searchInput.value.trim().toLowerCase();
                const status = statusFilter.value;
                const defaultValue = defaultFilter.value;

                let visibleCount = 0;

                rows.forEach(row => {

                    const matchesSearch =
                        row.dataset.search.includes(search);

                    const matchesStatus =
                        !status || row.dataset.status === status;

                    const matchesDefault =
                        !defaultValue || row.dataset.default === defaultValue;

                    const visible =
                        matchesSearch && matchesStatus && matchesDefault;

                    row.classList.toggle("d-none", !visible);

                    if (visible) visibleCount++;
                });

                if (noResults && tableBody) {
                    noResults.classList.toggle("d-none", visibleCount !== 0);
                }
            }

            searchInput.addEventListener("input", applyFilters);
            statusFilter.addEventListener("change", applyFilters);
            defaultFilter.addEventListener("change", applyFilters);

            clearButton?.addEventListener("click", function () {
                searchInput.value = "";
                statusFilter.value = "";
                defaultFilter.value = "";
                applyFilters();
            });

        });
    </script>
}
