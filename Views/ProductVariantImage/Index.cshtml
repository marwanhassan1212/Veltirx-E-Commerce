@model IReadOnlyList<Veltrix.DTOs.ProductVariantImage.ProductVariantImageDto>

@{
    ViewData["Title"] = "Variant Images";
    var variantId = (int)ViewBag.VariantId;
}

<div class="vx-page">

    <div class="vx-page-header">
        <div>
            <h1 class="vx-page-title">Variant Images</h1>
            <p class="vx-page-subtitle">
                Manage images assigned to this product variant.
            </p>
        </div>

        <div class="vx-page-actions">
            <a asp-controller="ProductVariant"
               asp-action="Index"
               asp-route-productId="0"
               class="vx-btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>

            <a asp-action="Create"
               asp-route-variantId="@variantId"
               class="vx-btn-primary">
                <i class="bi bi-plus-lg"></i>
                Upload Image
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="vx-alert vx-alert-success">
            <i class="bi bi-check-circle"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="vx-alert vx-alert-danger">
            <i class="bi bi-exclamation-circle"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="vx-content-card">

        <div class="vx-section-header">
            <div>
                <h2>Uploaded Images</h2>
                <p>
                    @Model.Count image(s) assigned to this variant.
                </p>
            </div>

            <span class="vx-count-badge">@Model.Count</span>
        </div>

        @if (Model.Any())
        {
            <div class="vx-variant-images-grid">

                @foreach (var image in Model.OrderBy(x => x.DisplayOrder).ThenBy(x => x.Id))
                {
                    <div class="vx-variant-image-card">

                        <div class="vx-variant-image-preview">
                            <img src="@image.ImageUrl"
                                 alt="@(image.AltText ?? "Variant image")"
                                 loading="lazy" />

                            @if (image.IsPrimary)
                            {
                                <span class="vx-primary-badge">
                                    <i class="bi bi-star-fill"></i>
                                    Primary
                                </span>
                            }
                    </div>

                    <div class="vx-variant-image-info">

                        <div class="vx-image-meta">
                            <span class="vx-image-order">
                                Order: @image.DisplayOrder
                            </span>

                            <span class="vx-image-id">
                                #@image.Id
                            </span>
                        </div>

                        <p class="vx-image-alt-text"
                           title="@(image.AltText ?? "No alt text")">
                            @(string.IsNullOrWhiteSpace(image.AltText)
                                                    ? "No alt text"
                                                    : image.AltText)
                    </p>

                            <div class="vx-image-actions">

                                <a asp-action="Edit"
                                   asp-route-id="@image.Id"
                                   class="vx-icon-action"
                                   title="Edit image">
                                    <i class="bi bi-pencil"></i>
                                </a>

                        @if (!image.IsPrimary)
                                {
                                    <form asp-action="SetPrimary"
                                          asp-route-id="@image.Id"
                                          method="post"
                                          class="vx-inline-form"
                                          onsubmit="return confirm('Make this the primary image?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="vx-icon-action vx-primary-action"
                                                title="Make primary">
                                            <i class="bi bi-star"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button"
                                            class="vx-icon-action vx-primary-action is-active"
                                            title="Current primary image"
                                            disabled>
                                        <i class="bi bi-star-fill"></i>
                                    </button>
                                }

                                <form asp-action="Delete"
                                      asp-route-id="@image.Id"
                                      method="post"
                                      class="vx-inline-form"
                                      onsubmit="return confirm('Are you sure you want to delete this image?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="vx-icon-action vx-delete-action"
                                            title="Delete image">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>

                            </div>
                        </div>
                    </div>
                }

            </div>
        }
        else
        {
            <div class="vx-empty-state">
                <div class="vx-empty-icon">
                    <i class="bi bi-images"></i>
                </div>

                <h3>No images uploaded yet</h3>

                <p>
                    Upload images to showcase this product variant.
                </p>

                <a asp-action="Create"
                   asp-route-variantId="@variantId"
                   class="vx-btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Upload First Image
                </a>
            </div>
        }

    </div>
</div>
