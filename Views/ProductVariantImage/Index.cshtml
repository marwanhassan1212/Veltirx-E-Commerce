@model IReadOnlyList<Veltrix.DTOs.ProductVariantImage.ProductVariantImageDto>

@{
    ViewData["Title"] = "Variant Images";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Variant Images</h2>
            <p class="text-muted mb-0">
                Manage images for this product variant.
            </p>
        </div>

        <a asp-action="Create"
           asp-route-variantId="@ViewBag.VariantId"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Upload Image
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-images display-4 text-muted"></i>

                <h5 class="mt-3">No images found</h5>

                <p class="text-muted">
                    Upload images for this variant to get started.
                </p>

                <a asp-action="Create"
                   asp-route-variantId="@ViewBag.VariantId"
                   class="btn btn-primary">
                    Upload First Image
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var image in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="position-relative">

                            <img src="@image.ImageUrl"
                                 alt="@image.AltText"
                                 class="card-img-top"
                                 style="height:220px; object-fit:cover;" />

                            @if (image.IsPrimary)
                            {
                                <span class="badge bg-success position-absolute top-0 start-0 m-2">
                                    Primary
                                </span>
                            }

                    </div>

                    <div class="card-body">

                        <h6 class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(image.AltText)
                                                    ? "No alt text"
                                                    : image.AltText)
                    </h6>

                            <p class="text-muted small mb-2">
                                Display Order: @image.DisplayOrder
                            </p>

                            <p class="text-muted small mb-3">
                                Added: @image.CreatedAt.ToString("dd MMM yyyy")
                            </p>

                            <div class="d-flex flex-wrap gap-2">

                                <a asp-action="Edit"
                                   asp-route-id="@image.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                        @if (!image.IsPrimary)
                                {
                                    <form asp-action="SetPrimary"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@image.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">
                                            Set Primary
                                        </button>
                                    </form>
                                }

                                <form asp-action="Delete"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this image?');">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@image.Id" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-controller="ProductVariant"
           asp-action="Edit"
           asp-route-id="@ViewBag.VariantId"
           class="btn btn-outline-secondary">
            Back to Variant
        </a>
    </div>

</div>