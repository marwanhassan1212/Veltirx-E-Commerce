@model Veltrix.DTOs.ProductVariantImage.CreateProductVariantImageDto

@{
    ViewData["Title"] = "Upload Variant Image";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Upload Variant Image</h2>
        <p class="text-muted">
            Add a new image to this product variant.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Create"
                  asp-route-variantId="@ViewBag.VariantId"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Image"
                           class="form-label fw-semibold">
                        Select Image
                    </label>

                    <input asp-for="Image"
                           type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <span asp-validation-for="Image"
                          class="text-danger"></span>

                    <div class="form-text">
                        Supported formats: JPG, JPEG, PNG, WEBP.
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="AltText"
                           class="form-label fw-semibold">
                        Alternative Text
                    </label>

                    <input asp-for="AltText"
                           class="form-control"
                           placeholder="Example: Black iPhone back view" />

                    <span asp-validation-for="AltText"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayOrder"
                           class="form-label fw-semibold">
                        Display Order
                    </label>

                    <input asp-for="DisplayOrder"
                           type="number"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="DisplayOrder"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsPrimary"
                           class="form-check-input" />

                    <label asp-for="IsPrimary"
                           class="form-check-label">
                        Set as primary image
                    </label>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Upload Image
                    </button>

                    <a asp-action="Index"
                       asp-route-variantId="@ViewBag.VariantId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}