@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    var isOrdersActive = currentController == "AdminOrders";
    var isProductsActive = currentController == "Product";
    var isCategoriesActive = currentController == "Category";
    var isFulfillmentActive = currentController == "OrderFulfillment";
    var isReturnsActive = currentController == "OrderReturn";
    var isRefundsActive = currentController == "Refund";
    var isCodActive = currentController == "CodReconciliation";
    var isShippingSettingsActive = currentController == "ShippingSettings";
    var isCouponsActive = currentController == "Coupons";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Veltrix Admin</title>

    <link rel="preconnect" href="https://cdn.jsdelivr.net" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />
</head>

<body>

    <a href="#mainContent" class="visually-hidden-focusable">
        Skip to main content
    </a>

    <div class="admin-wrapper">

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">

            <!-- Brand -->
            <div class="sidebar-brand">
                <span class="brand-mark">V</span>
                <span>VELTRIX</span>
            </div>

            <nav class="sidebar-nav" aria-label="Main navigation">

                <!-- Main Menu -->
                <div class="sidebar-label">MAIN MENU</div>

                <a href="#" class="nav-link" aria-label="Dashboard">
                    <i class="bi bi-grid"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="AdminOrders"
                   asp-action="Index"
                   class="nav-link @(isOrdersActive ? "active" : "")"
                   aria-current="@(isOrdersActive ? "page" : null)">
                    <i class="bi bi-receipt"></i>
                    <span>Orders</span>
                </a>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="nav-link @(isProductsActive ? "active" : "")"
                   aria-current="@(isProductsActive ? "page" : null)">
                    <i class="bi bi-box-seam"></i>
                    <span>Products</span>
                </a>

                <a asp-controller="Category"
                   asp-action="Index"
                   class="nav-link @(isCategoriesActive ? "active" : "")"
                   aria-current="@(isCategoriesActive ? "page" : null)">
                    <i class="bi bi-tags"></i>
                    <span>Categories</span>
                </a>

                <!-- Operations -->
                <div class="sidebar-label mt-4">OPERATIONS</div>

                <a href="#" class="nav-link">
                    <i class="bi bi-boxes"></i>
                    <span>Inventory</span>
                </a>

                <a href="#" class="nav-link">
                    <i class="bi bi-truck"></i>
                    <span>Shipments</span>
                </a>

                <a asp-controller="OrderFulfillment"
                   asp-action="Index"
                   class="nav-link @(isFulfillmentActive ? "active" : "")"
                   aria-current="@(isFulfillmentActive ? "page" : null)">
                    <i class="bi bi-box-seam"></i>
                    <span>Fulfillment</span>
                </a>

                <a asp-controller="OrderReturn"
                   asp-action="Index"
                   class="nav-link @(isReturnsActive ? "active" : "")"
                   aria-current="@(isReturnsActive ? "page" : null)">
                    <i class="bi bi-arrow-return-left"></i>
                    <span>Returns</span>
                </a>

                <a asp-controller="Refund"
                   asp-action="Index"
                   class="nav-link @(isRefundsActive ? "active" : "")"
                   aria-current="@(isRefundsActive ? "page" : null)">
                    <i class="bi bi-cash-stack"></i>
                    <span>Refunds</span>
                </a>

                <a asp-controller="CodReconciliation"
                   asp-action="Index"
                   class="nav-link @(isCodActive ? "active" : "")"
                   aria-current="@(isCodActive ? "page" : null)">
                    <i class="bi bi-wallet2"></i>
                    <span>COD Reconciliation</span>
                </a>

                <a asp-controller="ShippingSettings"
                   asp-action="Index"
                   class="nav-link @(isShippingSettingsActive ? "active" : "")"
                   aria-current="@(isShippingSettingsActive ? "page" : null)">
                    <i class="bi bi-gear"></i>
                    <span>Shipping Settings</span>
                </a>

                <!-- Marketing -->
                <div class="sidebar-label mt-4">MARKETING</div>

                <a asp-controller="Coupons"
                   asp-action="Index"
                   class="nav-link @(isCouponsActive ? "active" : "")"
                   aria-current="@(isCouponsActive ? "page" : null)">
                    <i class="bi bi-ticket-perforated"></i>
                    <span>Coupons</span>
                </a>

                <!-- Management -->
                <div class="sidebar-label mt-4">MANAGEMENT</div>

                <a href="#" class="nav-link">
                    <i class="bi bi-people"></i>
                    <span>Customers</span>
                </a>

                <a href="#" class="nav-link">
                    <i class="bi bi-person-badge"></i>
                    <span>Employees</span>
                </a>

                <a href="#" class="nav-link">
                    <i class="bi bi-sliders"></i>
                    <span>Settings</span>
                </a>

            </nav>

            <!-- Sidebar Footer -->
            <div class="sidebar-footer">

                <div class="admin-avatar">AD</div>

                <div class="admin-info">
                    <div class="admin-name">Administrator</div>
                    <div class="admin-role">Store Manager</div>
                </div>

                <i class="bi bi-three-dots ms-auto"></i>

            </div>

        </aside>

        <!-- Main Content -->
        <main class="main-content" id="mainContent">

            <!-- Topbar -->
            <header class="topbar">

                <div class="d-flex align-items-center gap-3">

                    <button class="sidebar-toggle"
                            id="sidebarToggle"
                            type="button"
                            aria-label="Toggle sidebar"
                            aria-controls="sidebar"
                            aria-expanded="true">

                        <i class="bi bi-list"></i>

                    </button>

                    <div class="breadcrumb-text">
                        Pages /
                        <strong>@ViewData["Title"]</strong>
                    </div>

                </div>

                <!-- Topbar User -->
                <div class="topbar-actions">

                    <div class="topbar-divider"></div>

                    <div class="topbar-user">

                        <div class="admin-avatar">AD</div>

                        <span>Admin</span>

                        <i class="bi bi-chevron-down"></i>

                    </div>

                </div>

            </header>

            <!-- Page Content -->
            <section class="page-content">

                @RenderBody()

            </section>

        </main>

    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/admin.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
