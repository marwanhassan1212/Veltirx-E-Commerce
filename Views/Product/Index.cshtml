@model Veltrix.DTOs.Common.PagedResultDto<Veltrix.DTOs.ProductDTO.ProductDto>

@{
    ViewData["Title"] = "Products";

    var products = Model?.Items ?? Array.Empty<Veltrix.DTOs.ProductDTO.ProductDto>();

    int totalProducts = products.Count;
    int publishedProducts = products.Count(x => x.IsPublished);
    int unpublishedProducts = totalProducts - publishedProducts;
    int categoriesCount = products.Select(x => x.CategoryId).Distinct().Count();
}

@section Styles {
    <style>
        .product-page {
            display: flex;
            flex-direction: column;
            gap: 22px;
            max-width: 1500px;
            margin: 0 auto;
        }

        .product-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 15px;
        }

            .product-heading h1 {
                margin: 0;
                font-size: 25px;
                font-weight: 750;
                letter-spacing: -.7px;
            }

            .product-heading p {
                margin: 7px 0 0;
                color: var(--vx-text-secondary);
                font-size: 12px;
            }

        .product-stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 15px;
        }

        .product-stat {
            display: flex;
            align-items: center;
            gap: 13px;
            min-width: 0;
            padding: 18px;
            border: 1px solid var(--vx-border);
            border-radius: 14px;
            background: #fff;
            box-shadow: var(--vx-shadow-sm);
        }

        .product-stat-icon {
            display: grid;
            width: 43px;
            height: 43px;
            flex-shrink: 0;
            place-items: center;
            border-radius: 12px;
            font-size: 18px;
        }

            .product-stat-icon.purple {
                background: #F0EDFF;
                color: #7657F6;
            }

            .product-stat-icon.green {
                background: #E6F7F0;
                color: #16A779;
            }

            .product-stat-icon.red {
                background: #FDECEF;
                color: #E05260;
            }

            .product-stat-icon.blue {
                background: #EAF3FF;
                color: #3985E8;
            }

        .product-stat-info span {
            display: block;
            color: var(--vx-text-secondary);
            font-size: 10px;
        }

        .product-stat-info strong {
            display: block;
            margin-top: 5px;
            color: var(--vx-text);
            font-size: 22px;
            font-weight: 750;
        }

        .product-panel {
            overflow: hidden;
            border: 1px solid var(--vx-border);
            border-radius: 15px;
            background: #fff;
            box-shadow: var(--vx-shadow-sm);
        }

        .product-panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            padding: 20px;
            border-bottom: 1px solid var(--vx-border);
        }

            .product-panel-header h2 {
                margin: 0;
                font-size: 14px;
                font-weight: 700;
            }

            .product-panel-header p {
                margin: 5px 0 0;
                color: var(--vx-text-muted);
                font-size: 10px;
            }

        .product-toolbar {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 9px;
        }

        .product-search {
            position: relative;
            width: 240px;
        }

            .product-search i {
                position: absolute;
                top: 50%;
                left: 12px;
                transform: translateY(-50%);
                color: var(--vx-text-muted);
            }

            .product-search input {
                width: 100%;
                height: 38px;
                padding: 0 12px 0 35px;
                border: 1px solid var(--vx-border);
                border-radius: 9px;
                outline: none;
                font-size: 11px;
            }

                .product-search input:focus {
                    border-color: var(--vx-primary);
                    box-shadow: 0 0 0 3px rgba(118, 87, 246, .1);
                }

        .product-filter {
            height: 38px;
            padding: 0 11px;
            border: 1px solid var(--vx-border);
            border-radius: 9px;
            background: #fff;
            color: var(--vx-text-secondary);
            font-size: 11px;
            outline: none;
        }

        .product-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .product-table {
            width: 100%;
            min-width: 1000px;
            border-collapse: collapse;
        }

            .product-table thead th {
                padding: 14px 18px;
                background: #FAFAFC;
                border-bottom: 1px solid var(--vx-border);
                color: var(--vx-text-muted);
                font-size: 9px;
                font-weight: 700;
                letter-spacing: .6px;
                text-align: left;
                white-space: nowrap;
            }

            .product-table tbody td {
                padding: 14px 18px;
                border-bottom: 1px solid #F1F1F5;
                color: var(--vx-text);
                font-size: 11px;
                vertical-align: middle;
            }

            .product-table tbody tr:last-child td {
                border-bottom: 0;
            }

            .product-table tbody tr:hover {
                background: #FCFBFF;
            }

        .product-identity {
            display: flex;
            align-items: center;
            gap: 11px;
            min-width: 220px;
        }

        .product-image {
            display: grid;
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            place-items: center;
            overflow: hidden;
            border: 1px solid #ECEAF5;
            border-radius: 10px;
            background: #F5F3FF;
            color: var(--vx-primary);
            font-size: 18px;
        }

            .product-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .product-identity strong {
            display: block;
            max-width: 220px;
            overflow: hidden;
            font-size: 11px;
            font-weight: 700;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .product-identity span {
            display: block;
            max-width: 220px;
            margin-top: 4px;
            overflow: hidden;
            color: var(--vx-text-muted);
            font-size: 9px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .product-sku {
            color: var(--vx-text-secondary);
            font-family: monospace;
            font-size: 10px;
            white-space: nowrap;
        }

        .product-category {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--vx-text-secondary);
            font-size: 10px;
            font-weight: 600;
            white-space: nowrap;
        }

        .product-price {
            color: var(--vx-text);
            font-size: 11px;
            font-weight: 750;
            white-space: nowrap;
        }

        .product-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 9px;
            border-radius: 6px;
            font-size: 9px;
            font-weight: 650;
            white-space: nowrap;
        }

            .product-status.published {
                background: #E6F7F0;
                color: #16A779;
            }

            .product-status.unpublished {
                background: #FDECEF;
                color: #E05260;
            }

            .product-status i {
                font-size: 7px;
            }

        .product-actions {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 6px;
        }

        .product-action {
            display: grid;
            width: 32px;
            height: 32px;
            flex-shrink: 0;
            place-items: center;
            border: 1px solid var(--vx-border);
            border-radius: 8px;
            background: #fff;
            color: var(--vx-text-secondary);
            text-decoration: none;
            transition: .2s ease;
        }

            .product-action:hover {
                border-color: #D8D0FF;
                background: #F3F0FF;
                color: var(--vx-primary);
            }

            .product-action.publish:hover {
                border-color: #BDEBD9;
                background: #E6F7F0;
                color: #16A779;
            }

            .product-action.unpublish:hover {
                border-color: #F7C8D0;
                background: #FDECEF;
                color: #E05260;
            }

        .product-empty {
            padding: 55px 20px;
            text-align: center;
        }

        .product-empty-icon {
            display: grid;
            width: 65px;
            height: 65px;
            margin: 0 auto 16px;
            place-items: center;
            border-radius: 18px;
            background: #F0EDFF;
            color: var(--vx-primary);
            font-size: 26px;
        }

        .product-empty h3 {
            margin-bottom: 7px;
            font-size: 15px;
            font-weight: 700;
        }

        .product-empty p {
            max-width: 330px;
            margin: 0 auto 18px;
            color: var(--vx-text-secondary);
            font-size: 11px;
            line-height: 1.7;
        }

        .product-panel-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            padding: 15px 20px;
            border-top: 1px solid var(--vx-border);
            color: var(--vx-text-muted);
            font-size: 10px;
        }

        .product-footer-meta {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .product-no-results {
            display: none;
        }

        .product-alert {
            padding: 12px 15px;
            border-radius: 9px;
            font-size: 11px;
        }

        @@media (max-width: 1100px) {
            .product-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 575.98px) {
            .product-heading {
                align-items: stretch;
                flex-direction: column;
            }

            .product-heading-actions {
                width: 100%;
            }

                .product-heading-actions a {
                    width: 100%;
                }

            .product-stats {
                gap: 9px;
            }

            .product-stat {
                gap: 9px;
                padding: 12px;
            }

            .product-stat-icon {
                width: 34px;
                height: 34px;
                font-size: 15px;
            }

            .product-stat-info strong {
                font-size: 18px;
            }

            .product-panel-header {
                align-items: stretch;
                flex-direction: column;
                padding: 16px;
            }

            .product-toolbar {
                align-items: stretch;
                flex-direction: column;
            }

            .product-search {
                width: 100%;
            }

            .product-filter {
                width: 100%;
            }

            .product-panel-footer {
                align-items: flex-start;
                flex-direction: column;
            }

            .product-footer-meta {
                align-items: flex-start;
                flex-direction: column;
                gap: 8px;
            }
        }

        @@media (max-width: 350px) {
            .product-stat {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
}

<div class="product-page">

    <!-- Page Heading -->
    <section class="product-heading">
        <div>
            <h1>Products</h1>
            <p>Manage your product catalog and publication status.</p>
        </div>

        <div class="product-heading-actions">
            <a asp-controller="Product"
               asp-action="Create"
               class="vx-btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Add Product
            </a>
        </div>
    </section>

    <!-- TempData Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success product-alert mb-0">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger product-alert mb-0">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
        </div>
    }

    <!-- Statistics -->
    <section class="product-stats">

        <div class="product-stat">
            <div class="product-stat-icon purple">
                <i class="bi bi-box-seam"></i>
            </div>
            <div class="product-stat-info">
                <span>Total Products</span>
                <strong>@totalProducts</strong>
            </div>
        </div>

        <div class="product-stat">
            <div class="product-stat-icon green">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="product-stat-info">
                <span>Published</span>
                <strong>@publishedProducts</strong>
            </div>
        </div>

        <div class="product-stat">
            <div class="product-stat-icon red">
                <i class="bi bi-eye-slash"></i>
            </div>
            <div class="product-stat-info">
                <span>Unpublished</span>
                <strong>@unpublishedProducts</strong>
            </div>
        </div>

        <div class="product-stat">
            <div class="product-stat-icon blue">
                <i class="bi bi-grid"></i>
            </div>
            <div class="product-stat-info">
                <span>Categories Used</span>
                <strong>@categoriesCount</strong>
            </div>
        </div>

    </section>

    <!-- Products Table -->
    <section class="product-panel">

        <div class="product-panel-header">
            <div>
                <h2>All Products</h2>
                <p>View and manage your product records.</p>
            </div>

            <!-- Client-side Search and Filter -->
            <div class="product-toolbar">

                <div class="product-search">
                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="productSearch"
                           placeholder="Search products..."
                           aria-label="Search products" />
                </div>

                <select id="productStatusFilter"
                        class="product-filter"
                        aria-label="Filter by publication status">

                    <option value="all">All Statuses</option>
                    <option value="published">Published</option>
                    <option value="unpublished">Unpublished</option>

                </select>

            </div>
        </div>

        @if (products.Any())
        {
            <div class="product-table-wrapper">

                <table class="product-table">
                    <thead>
                        <tr>
                            <th>PRODUCT</th>
                            <th>SKU</th>
                            <th>CATEGORY</th>
                            <th>PRICE</th>
                            <th>STATUS</th>
                            <th style="text-align: right;">ACTIONS</th>
                        </tr>
                    </thead>

                    <tbody id="productTableBody">

                        @foreach (var product in products)
                        {
                            <tr class="product-row"
                                data-name="@product.Name"
                                data-slug="@product.Slug"
                                data-sku="@product.SKU"
                                data-category="@product.CategoryName"
                                data-status="@(product.IsPublished ? "published" : "unpublished")">

                                <td>
                                    <div class="product-identity">
                                        <div>
                                            <strong title="@product.Name">
                                                @product.Name
                                            </strong>

                                            <span title="@product.Slug">
                                                @product.Slug
                                            </span>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(product.SKU))
                                    {
                                        <span class="product-sku">@product.SKU</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not configured</span>
                                    }
                                </td>

                                <td>
                                    <span class="product-category">
                                        <i class="bi bi-grid"></i>
                                        @product.CategoryName
                                    </span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(product.SKU))
                                    {
                                        <span class="product-price">
                                            @product.Price.ToString("N2")
                                            <small>EGP</small>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not configured</span>
                                    }
                                </td>

                                <td>
                                    @if (product.IsPublished)
                                    {
                                        <span class="product-status published">
                                            <i class="bi bi-circle-fill"></i>
                                            Published
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="product-status unpublished">
                                            <i class="bi bi-circle-fill"></i>
                                            Unpublished
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="product-actions">

                                        <a asp-controller="Product"
                                           asp-action="Details"
                                           asp-route-id="@product.Id"
                                           class="product-action"
                                           title="View Details"
                                           aria-label="View product details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-controller="Product"
                                           asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="product-action"
                                           title="Edit Product"
                                           aria-label="Edit product">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (product.IsPublished)
                                        {
                                            <form asp-controller="Product"
                                                  asp-action="Unpublish"
                                                  asp-route-id="@product.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="product-action unpublish"
                                                        title="Unpublish Product"
                                                        aria-label="Unpublish product">
                                                    <i class="bi bi-send-check"></i>
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Product"
                                                  asp-action="Publish"
                                                  asp-route-id="@product.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="product-action publish"
                                                        title="Publish Product"
                                                        aria-label="Publish product">
                                                    <i class="bi-eye-slash"></i>
                                                </button>

                                            </form>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>
                </table>

                <!-- No Search Results -->
                <div id="productNoResults"
                     class="product-empty product-no-results">

                    <div class="product-empty-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h3>No matching products</h3>

                    <p>
                        No products match your search or selected status.
                        Try changing your search criteria.
                    </p>

                    <button type="button"
                            id="clearProductFilters"
                            class="vx-btn-outline">
                        Clear Filters
                    </button>

                </div>

            </div>

            <div class="product-panel-footer">

                <div>
                    Showing <strong id="productVisibleCount">@totalProducts</strong>
                    of <strong>@totalProducts</strong> products
                </div>

                <div class="product-footer-meta">
                    <span>
                        <i class="bi bi-shield-check me-1"></i>
                        Product management
                    </span>
                </div>

            </div>
        }
        else
        {
            <div class="product-empty">

                <div class="product-empty-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <h3>No products yet</h3>

                <p>
                    You haven't created any products.
                    Start building your catalog by adding your first product.
                </p>

                <a asp-controller="Product"
                   asp-action="Create"
                   class="vx-btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>
                    Create First Product
                </a>

            </div>
        }

    </section>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("productSearch");
            const statusFilter = document.getElementById("productStatusFilter");
            const rows = document.querySelectorAll(".product-row");

            const noResults = document.getElementById("productNoResults");
            const clearButton = document.getElementById("clearProductFilters");
            const visibleCount = document.getElementById("productVisibleCount");

            if (!searchInput || !statusFilter) {
                return;
            }

            function filterProducts() {

                const searchValue = searchInput.value.trim().toLowerCase();
                const selectedStatus = statusFilter.value;

                let count = 0;

                rows.forEach(row => {

                    const name = (row.dataset.name || "").toLowerCase();
                    const slug = (row.dataset.slug || "").toLowerCase();
                    const sku = (row.dataset.sku || "").toLowerCase();
                    const category = (row.dataset.category || "").toLowerCase();
                    const status = row.dataset.status;

                    const matchesSearch =
                        name.includes(searchValue) ||
                        slug.includes(searchValue) ||
                        sku.includes(searchValue) ||
                        category.includes(searchValue);

                    const matchesStatus =
                        selectedStatus === "all" ||
                        selectedStatus === status;

                    const isVisible = matchesSearch && matchesStatus;

                    row.style.display = isVisible ? "" : "none";

                    if (isVisible) {
                        count++;
                    }
                });

                if (visibleCount) {
                    visibleCount.textContent = count;
                }

                if (noResults) {
                    noResults.style.display = count === 0 ? "block" : "none";
                }
            }

            searchInput.addEventListener("input", filterProducts);
            statusFilter.addEventListener("change", filterProducts);

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    searchInput.value = "";
                    statusFilter.value = "all";
                    filterProducts();
                });
            }

            filterProducts();
        });
    </script>
}
