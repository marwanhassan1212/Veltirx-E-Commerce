@model Veltrix.DTOs.Common.PagedResultDto<Veltrix.DTOs.ProductDTO.ProductDto>

@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid products-page">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 page-header">
        <div>
            <h2 class="fw-bold mb-1">Products</h2>
            <p class="text-muted mb-0">
                Manage your store products from one place.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Product
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters -->
    <div class="card border-0 product-filters">
        <div class="card-body">

            <div class="row g-3 align-items-end">

                <!-- Search -->
                <div class="col-lg-5">
                    <label class="form-label">Search products</label>

                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="search"
                               id="productSearchInput"
                               class="form-control"
                               placeholder="Search by name, SKU, slug or category..."
                               autocomplete="off" />
                    </div>
                </div>

                <!-- Publication Status -->
                <div class="col-lg-3">
                    <label class="form-label">Publication status</label>

                    <select id="productStatusFilter" class="form-select">
                        <option value="all">All products</option>
                        <option value="published">Published</option>
                        <option value="unpublished">Unpublished</option>
                    </select>
                </div>

                <!-- Page Size -->
                <div class="col-lg-2">
                    <label class="form-label">Items per page</label>

                    <select id="pageSizeFilter"
                            name="pageSize"
                            class="form-select"
                            onchange="changePageSize(this.value)">

                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="20" selected="@(Model.PageSize == 20)">20</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>

                    </select>
                </div>

                <!-- Clear Filters -->
                <div class="col-lg-2">
                    <button type="button"
                            id="clearCategoryFilters"
                            class="vx-btn-secondary">

                        <i class="bi bi-arrow-counterclockwise"></i>
                        Clear Filters

                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Products Card -->
    <div class="card border-0 products-card">

        <!-- Card Header -->
        <div class="card-header bg-white border-0">
            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">Product List</h5>

                <span class="text-muted small">
                    @Model.TotalCount products in total
                </span>

            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body p-0">

            @if (Model.Items.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead>
                            <tr>
                                <th class="ps-4">Product</th>
                                <th>SKU</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody id="productTableBody">

                            @foreach (var product in Model.Items)
                            {
                                <tr data-search="@($"{product.Name} {product.SKU} {product.Slug} {product.CategoryName}")"
                                    data-status="@(product.IsPublished ? "published" : "unpublished")">

                                    <!-- Product Information -->
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">

                                            @if (product.ImageUrls.Any())
                                            {
                                                <img src="@product.ImageUrls.First()"
                                                     alt="@product.Name"
                                                     class="product-thumbnail" />
                                            }
                                            else
                                            {
                                                <div class="product-placeholder">
                                                    <i class="bi bi-image"></i>
                                                </div>
                                            }

                                            <div>
                                                <a asp-action="Details"
                                                   asp-route-id="@product.Id"
                                                   class="product-name">
                                                    @product.Name
                                                </a>

                                                <div class="product-slug">
                                                    @product.Slug
                                                </div>
                                            </div>

                                        </div>
                                    </td>

                                    <!-- SKU -->
                                    <td>
                                        @product.SKU
                                    </td>

                                    <!-- Category -->
                                    <td>
                                        @product.CategoryName
                                    </td>

                                    <!-- Price -->
                                    <td class="fw-semibold">
                                        @product.Price.ToString("N2")
                                    </td>

                                    <!-- Status -->
                                    <td>
                                        @if (product.IsPublished)
                                        {
                                            <span class="status-badge status-published">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-unpublished">
                                                <i class="bi bi-dash-circle"></i>
                                                Unpublished
                                            </span>
                                        }
                                    </td>

                                    <!-- Created Date -->
                                    <td>
                                        <span class="text-muted small">
                                            @product.CreatedAt.ToString("dd MMM yyyy")
                                        </span>
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-end pe-4">
                                        <div class="product-actions">

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@product.Id"
                                               class="btn"
                                               title="View details">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@product.Id"
                                               class="btn"
                                               title="Edit product">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <!-- Publish / Unpublish -->
                                            @if (product.IsPublished)
                                            {
                                                <form asp-action="Unpublish"
                                                      asp-route-id="@product.Id"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to unpublish this product?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn"
                                                            title="Unpublish product">
                                                        <i class="bi bi-cloud-upload"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Publish"
                                                      asp-route-id="@product.Id"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to publish this product?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn"
                                                            title="Publish product">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>

                                </tr>
                            }

                            <!-- No Search Results -->
                            <tr id="noSearchResults" style="display: none;">
                                <td colspan="7" class="text-center py-5">

                                    <i class="bi bi-search fs-3 text-muted"></i>

                                    <h6 class="mt-3 mb-1">
                                        No matching products
                                    </h6>

                                    <p class="text-muted small mb-0">
                                        Try changing your search term or publication status.
                                    </p>

                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="empty-state">

                    <i class="bi bi-box-seam"></i>

                    <h5>No products found</h5>

                    <p>
                        Create your first product to get started.
                    </p>

                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add Product
                    </a>

                </div>
            }

        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                    <span class="text-muted small">
                        Page @Model.PageNumber of @Model.TotalPages
                    </span>

                    <nav aria-label="Products pagination">

                        <ul class="pagination pagination-sm mb-0">

                            <!-- Previous -->
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    Previous
                                </a>

                            </li>

                            <!-- Page Numbers -->
                            @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-pageNumber="@pageNumber"
                                       asp-route-pageSize="@Model.PageSize">
                                        @pageNumber
                                    </a>

                                </li>
                            }

                            <!-- Next -->
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    Next
                                </a>

                            </li>

                        </ul>

                    </nav>

                </div>

            </div>
        }

    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("productSearchInput");
            const statusFilter = document.getElementById("productStatusFilter");
            const clearFiltersButton = document.getElementById("clearFiltersButton");

            const tableBody = document.getElementById("productTableBody");
            const noResultsRow = document.getElementById("noSearchResults");

            if (!tableBody) return;

            const productRows = Array.from(
                tableBody.querySelectorAll("tr[data-search]")
            );

            function filterProducts() {

                const searchValue = searchInput.value.trim().toLowerCase();
                const selectedStatus = statusFilter.value;

                let visibleCount = 0;

                productRows.forEach(row => {

                    const searchableText = row.dataset.search.toLowerCase();
                    const productStatus = row.dataset.status;

                    const matchesSearch =
                        searchableText.includes(searchValue);

                    const matchesStatus =
                        selectedStatus === "all" ||
                        productStatus === selectedStatus;

                    const isVisible = matchesSearch && matchesStatus;

                    row.style.display = isVisible ? "" : "none";

                    if (isVisible) {
                        visibleCount++;
                    }

                });

                if (noResultsRow) {
                    noResultsRow.style.display =
                        visibleCount === 0 ? "" : "none";
                }
            }

            // Live Search
            searchInput.addEventListener("input", filterProducts);

            // Live Publication Status Filter
            statusFilter.addEventListener("change", filterProducts);

            // Clear Filters
            clearFiltersButton.addEventListener("click", function () {

                searchInput.value = "";
                statusFilter.value = "all";

                filterProducts();

            });

        });

        // Server-side Page Size
        function changePageSize(pageSize) {

            const url = new URL(window.location.href);

            url.searchParams.set("pageSize", pageSize);
            url.searchParams.set("pageNumber", "1");

            // Remove old server-side filters
            url.searchParams.delete("search");
            url.searchParams.delete("status");

            window.location.href = url.toString();
        }

    </script>

}
