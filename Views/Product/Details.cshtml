@model Veltrix.DTOs.ProductDTO.ProductDto

@{
    ViewData["Title"] = "Product Details";
    var firstImage = Model.ImageUrls?.FirstOrDefault();
}

<div class="products-page product-details-page">

    <div class="product-page-heading">
        <div>
            <h1>Product Details</h1>
            <p>View product information and manage its related resources.</p>
        </div>

        <div class="product-heading-actions">
            <a asp-action="Index"
               class="vx-btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="vx-btn-primary">
                <i class="bi bi-pencil"></i>
                Edit Product
            </a>
        </div>
    </div>

    <div class="product-details-panel">

        <!-- Product Overview -->
        <div class="product-overview">

            <div class="product-details-image">

                @if (!string.IsNullOrWhiteSpace(firstImage))
                {
                    <img src="@firstImage"
                         alt="@Model.Name" />
                }
                else
                {
                    <div class="product-details-placeholder">
                        <i class="bi bi-image"></i>
                        <span>No image available</span>
                    </div>
                }

            </div>

            <div class="product-overview-info">

                <div class="product-overview-top">
                    <span class="product-category-label">
                        @Model.CategoryName
                    </span>

                    @if (Model.IsPublished)
                    {
                        <span class="product-detail-status published">
                            <i class="bi bi-check-circle-fill"></i>
                            Published
                        </span>
                    }
                    else
                    {
                        <span class="product-detail-status unpublished">
                            <i class="bi bi-eye-slash-fill"></i>
                            Unpublished
                        </span>
                    }
                </div>

                <h2>@Model.Name</h2>

                <p class="product-details-slug">
                    /@Model.Slug
                </p>

                <div class="product-overview-meta">
                    <div>
                        <span>SKU</span>
                        <strong>@Model.SKU</strong>
                    </div>

                    <div>
                        <span>Price</span>
                        <strong>@Model.Price.ToString("N2")</strong>
                    </div>

                    <div>
                        <span>Product ID</span>
                        <strong>#@Model.Id</strong>
                    </div>
                </div>

            </div>
        </div>

        <!-- Product Information -->
        <div class="product-details-section">

            <div class="product-section-heading">
                <h5>Product Information</h5>
                <p>Basic details and descriptions.</p>
            </div>

            <div class="product-information-grid">

                <div class="product-information-item">
                    <span>Product Name</span>
                    <strong>@Model.Name</strong>
                </div>

                <div class="product-information-item">
                    <span>Category</span>
                    <strong>@Model.CategoryName</strong>
                </div>

                <div class="product-information-item">
                    <span>SKU</span>
                    <strong>@Model.SKU</strong>
                </div>

                <div class="product-information-item">
                    <span>Price</span>
                    <strong>@Model.Price.ToString("N2")</strong>
                </div>

                <div class="product-information-item">
                    <span>Created At</span>
                    <strong>@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</strong>
                </div>

                <div class="product-information-item">
                    <span>Last Updated</span>
                    <strong>
                        @(Model.UpdatedAt.HasValue
                                                ? Model.UpdatedAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                                                : "Not updated yet")
                    </strong>
                </div>

            </div>

            <div class="product-description-block">
                <h6>Short Description</h6>

                @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                {
                    <p>@Model.ShortDescription</p>
                }
                else
                {
                    <p class="product-no-data">No short description provided.</p>
                }
            </div>

            <div class="product-description-block">
                <h6>Full Description</h6>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p>@Model.Description</p>
                }
                else
                {
                    <p class="product-no-data">No full description provided.</p>
                }
            </div>

        </div>

        <!-- Product Images -->
        <div class="product-details-section">

            <div class="product-section-heading">
                <div>
                    <h5>Product Images</h5>
                    <p>Manage the images associated with this product.</p>
                </div>

                <a asp-controller="ProductImage"
                   asp-action="Index"
                   asp-route-productId="@Model.Id"
                   class="vx-btn-secondary">
                    <i class="bi bi-images"></i>
                    Manage Images
                </a>
            </div>

            @if (Model.ImageUrls != null && Model.ImageUrls.Any())
            {
                <div class="product-image-gallery">
                    @foreach (var imageUrl in Model.ImageUrls)
                    {
                        <div class="product-gallery-item">
                            <img src="@imageUrl" alt="@Model.Name" />
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="product-related-empty">
                    <i class="bi bi-image"></i>
                    <span>No images have been added to this product yet.</span>
                </div>
            }

        </div>

        <!-- Related Resources -->
        <div class="product-details-section">

            <div class="product-section-heading">
                <div>
                    <h5>Product Configuration</h5>
                    <p>Manage variants and their available options.</p>
                </div>
            </div>

            <div class="product-resource-grid">

                <a asp-controller="ProductVariant"
                   asp-action="Index"
                   asp-route-productId="@Model.Id"
                   class="product-resource-card">

                    <div class="product-resource-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <div>
                        <strong>Product Variants</strong>
                        <span>Manage SKUs, prices and variant settings.</span>
                    </div>

                    <i class="bi bi-arrow-right product-resource-arrow"></i>
                </a>

                <a asp-controller="VariantOptions"
                   asp-action="Index"
                   asp-route-productId="@Model.Id"
                   class="product-resource-card">

                    <div class="product-resource-icon">
                        <i class="bi bi-sliders"></i>
                    </div>

                    <div>
                        <strong>Variant Options</strong>
                        <span>Manage option groups and their values.</span>
                    </div>

                    <i class="bi bi-arrow-right product-resource-arrow"></i>
                </a>

            </div>

        </div>

        <!-- Footer -->
        <div class="product-details-footer">

            <a asp-action="Index"
               class="vx-btn-secondary">
                Back to Products
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="vx-btn-primary">
                <i class="bi bi-pencil"></i>
                Edit Product
            </a>

        </div>

    </div>
</div>