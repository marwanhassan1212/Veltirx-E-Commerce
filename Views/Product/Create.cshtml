@using Microsoft.AspNetCore.Mvc.Rendering
@model Veltrix.DTOs.ProductDTO.CreateProductDto

@{
    ViewData["Title"] = "Create Product";
    var categories = ViewBag.Categories as IEnumerable<dynamic>;
}

<div class="products-page product-form-page">

    <div class="product-page-heading">
        <div>
            <h1>Create Product</h1>
            <p>Add a new product to your store catalog.</p>
        </div>

        <a asp-controller="Product"
           asp-action="Index"
           class="vx-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Products
        </a>
    </div>

    <div class="product-form-panel">

        <div class="product-form-header">
            <div>
                <h5>Product Information</h5>
                <p>Enter the basic information needed to create your product.</p>
            </div>
        </div>

        <form asp-action="Create"
              asp-controller="Product"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger validation-summary">
            </div>

            <div class="product-form-body">

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">
                            Product Name <span class="required-mark">*</span>
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter product name" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Slug" class="form-label">
                            Slug <span class="required-mark">*</span>
                        </label>

                        <input asp-for="Slug"
                               class="form-control"
                               placeholder="product-url-slug" />

                        <span asp-validation-for="Slug"
                              class="text-danger"></span>

                        <small class="form-hint">
                            Used in the product URL.
                        </small>
                    </div>

                    <div class="col-12">
                        <label asp-for="CategoryId" class="form-label">
                            Category <span class="required-mark">*</span>
                        </label>

                        <select asp-for="CategoryId"
                                class="form-select">
                            <option value="">Select a category</option>

                            @if (ViewBag.Categories != null)
                            {
                                foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }
                            }
                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ShortDescription" class="form-label">
                            Short Description
                        </label>

                        <textarea asp-for="ShortDescription"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Write a short description about this product..."></textarea>

                        <span asp-validation-for="ShortDescription"
                              class="text-danger"></span>

                        <small class="form-hint">
                            Maximum 500 characters.
                        </small>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">
                            Full Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control product-description-input"
                                  rows="6"
                                  maxlength="4000"
                                  placeholder="Write the full product description..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>

                        <small class="form-hint">
                            Maximum 4000 characters.
                        </small>
                    </div>

                </div>

                <div class="product-form-actions">
                    <a asp-action="Index"
                       class="vx-btn-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="vx-btn-primary">
                        <i class="bi bi-plus-lg"></i>
                        Create Product
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}