@model Veltrix.DTOs.CategoryDTO.CategoryDto

@{
    ViewData["Title"] = "Category Details";
    Layout = "_Layout";
}

<div class="category-page">

    <div class="category-heading">
        <div>
            <h1>Category Details</h1>
            <p>View category information and associated products count.</p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="vx-btn-primary">
                <i class="bi bi-pencil"></i>
                Edit Category
            </a>

            <a asp-action="Index" class="vx-btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>

        </div>
    </div>

    <div class="category-details-panel">

        <div class="category-details-header">
            <div class="category-details-image">

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.Name" />
                }
                else
                {
                    <div class="category-placeholder large">
                        <i class="bi bi-image"></i>
                    </div>
                }

            </div>

            <div class="category-details-title">

                <div class="d-flex align-items-center gap-2 flex-wrap">

                    <h2>@Model.Name</h2>

                    @if (Model.IsActive)
                    {
                        <span class="category-status active">Active</span>
                    }
                    else
                    {
                        <span class="category-status inactive">Inactive</span>
                    }

                </div>

                <p>@Model.Slug</p>

                <span class="text-muted">
                    Category ID: #@Model.Id
                </span>

            </div>
        </div>

        <div class="category-details-grid">

            <div class="category-detail-item">
                <span>Parent Category</span>
                <strong>
                    @(Model.ParentCategoryName ?? "Main Category")
                </strong>
            </div>

            <div class="category-detail-item">
                <span>Products Count</span>
                <strong>@Model.ProductsCount</strong>
            </div>

            <div class="category-detail-item">
                <span>Display Order</span>
                <strong>@Model.DisplayOrder</strong>
            </div>

            <div class="category-detail-item">
                <span>Status</span>
                <strong>
                    @(Model.IsActive ? "Active" : "Inactive")
                </strong>
            </div>

            <div class="category-detail-item">
                <span>Created At</span>
                <strong>@Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</strong>
            </div>

            <div class="category-detail-item">
                <span>Last Updated</span>
                <strong>
                    @(Model.UpdatedAt.HasValue
                                        ? Model.UpdatedAt.Value.ToString("MMM dd, yyyy hh:mm tt")
                                        : "Never updated")
                </strong>
            </div>

        </div>

        <div class="category-description-section">
            <h5>Description</h5>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p>@Model.Description</p>
            }
            else
            {
                <p class="text-muted">No description available.</p>
            }
        </div>

        <div class="category-details-footer">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="vx-btn-primary">
                <i class="bi bi-pencil"></i>
                Edit Category
            </a>

            <a asp-action="Index" class="vx-btn-secondary">
                Back to Categories
            </a>

        </div>

    </div>
</div>
