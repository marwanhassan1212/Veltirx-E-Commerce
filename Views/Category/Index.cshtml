@model dynamic

@{
    ViewData["Title"] = "Categories";
    Layout = "_Layout";

    var statistics = ViewBag.Statistics;
    var search = ViewBag.Search as string ?? "";
    var status = ViewBag.Status as string ?? "all";
    var pageSize = (int)(ViewBag.PageSize ?? 10);
}

<div class="category-page">

    <!-- Page Header -->
    <div class="category-heading">
        <div>
            <h1>Categories</h1>
            <p>Manage your store categories and organize your products.</p>
        </div>

        <a asp-action="Create" class="vx-btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Category
        </a>
    </div>

    <!-- Success Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics -->
    <div class="category-stats">

        <div class="category-stat-card">
            <div class="category-stat-icon">
                <i class="bi bi-grid"></i>
            </div>
            <div>
                <span>Total Categories</span>
                <h3>@statistics.TotalCategories</h3>
            </div>
        </div>

        <div class="category-stat-card">
            <div class="category-stat-icon active-icon">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <span>Active Categories</span>
                <h3>@statistics.ActiveCategories</h3>
            </div>
        </div>

        <div class="category-stat-card">
            <div class="category-stat-icon inactive-icon">
                <i class="bi bi-pause-circle"></i>
            </div>
            <div>
                <span>Inactive Categories</span>
                <h3>@statistics.InactiveCategories</h3>
            </div>
        </div>

        <div class="category-stat-card">
            <div class="category-stat-icon parent-icon">
                <i class="bi bi-diagram-3"></i>
            </div>
            <div>
                <span>Parent Categories</span>
                <h3>@statistics.ParentCategories</h3>
            </div>
        </div>

    </div>

    <!-- Categories Panel -->
    <div class="category-panel">

        <!-- Panel Header -->
        <div class="category-panel-header">
            <div>
                <h5>All Categories</h5>
                <p>View and manage all categories in your store.</p>
            </div>
        </div>

        <!-- Filters -->
        <div class="category-filters">

            <!-- Search -->
            <div class="category-search">
                <i class="bi bi-search"></i>

                <input type="search"
                       id="categorySearchInput"
                       placeholder="Search by category name, slug or parent..."
                       autocomplete="off" />
            </div>

            <!-- Status -->
            <select id="categoryStatusFilter"
                    class="form-select category-filter-select">

                <option value="all">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>

            </select>

            <!-- Page Size -->
            <select id="categoryPageSize"
                    class="form-select category-filter-select"
                    onchange="changeCategoryPageSize(this.value)">

                <option value="10" selected="@(pageSize == 10)">10 per page</option>
                <option value="20" selected="@(pageSize == 20)">20 per page</option>
                <option value="50" selected="@(pageSize == 50)">50 per page</option>

            </select>

            <!-- Clear Filters -->
            <button type="button"
                    id="clearCategoryFilters"
                    class="vx-btn-secondary">

                <i class="bi bi-arrow-counterclockwise"></i>
                Clear Filters

            </button>

        </div>

        <!-- Categories Table -->
        <div class="table-responsive">

            <table class="table category-table align-middle">

                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Slug</th>
                        <th>Parent Category</th>
                        <th>Products</th>
                        <th>Display Order</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody id="categoryTableBody">

                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8">
                                <div class="category-empty-state">
                                    <i class="bi bi-folder2-open"></i>
                                    <h6>No Categories Found</h6>
                                    <p>Try changing your search or create a new category.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var category in Model.Items)
                        {
                            <tr class="category-row"
                                data-name="@category.Name"
                                data-slug="@category.Slug"
                                data-parent="@category.ParentCategoryName"
                                data-status="@(category.IsActive ? "active" : "inactive")">

                                <!-- Category -->
                                <td>
                                    <div class="category-identity">

                                        @if (!string.IsNullOrWhiteSpace((string?)category.ImageUrl))
                                        {
                                            <img src="@category.ImageUrl"
                                                 alt="@category.Name"
                                                 class="category-thumbnail" />
                                        }
                                        else
                                        {
                                            <div class="category-placeholder">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }

                                        <div>
                                            <strong>@category.Name</strong>
                                            <small>ID: #@category.Id</small>
                                        </div>

                                    </div>
                                </td>

                                <!-- Slug -->
                                <td>
                                    <span class="category-slug">
                                        @category.Slug
                                    </span>
                                </td>

                                <!-- Parent Category -->
                                <td>
                                    @if (category.ParentCategoryName != null)
                                    {
                                        @category.ParentCategoryName
                                    }
                                    else
                                    {
                                        <span class="text-muted">Main Category</span>
                                    }
                                </td>

                                <!-- Products -->
                                <td>
                                    <span class="category-product-count">
                                        @category.ProductsCount
                                    </span>
                                </td>

                                <!-- Display Order -->
                                <td>
                                    @category.DisplayOrder
                                </td>

                                <!-- Status -->
                                <td>
                                    @if (category.IsActive)
                                    {
                                        <span class="category-status active">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="category-status inactive">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <!-- Created At -->
                                <td>
                                    @category.CreatedAt.ToString("MMM dd, yyyy")
                                </td>

                                <!-- Actions -->
                                <td>
                                    <div class="category-actions">

                                        <a asp-action="Details"
                                           asp-route-id="@category.Id"
                                           class="category-action"
                                           title="Details">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@category.Id"
                                           class="category-action"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }
                    }

                    <!-- No Matching Results -->
                    <tr id="noCategoryResults" style="display: none;">
                        <td colspan="8">

                            <div class="category-empty-state">
                                <i class="bi bi-search"></i>

                                <h6>No Matching Categories</h6>

                                <p>
                                    Try changing your search term or status filter.
                                </p>
                            </div>

                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

        <!-- Pagination -->
        <div class="category-pagination">

            <div class="category-pagination-info">
                Showing
                <strong>@(Model.TotalCount == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1)</strong>
                to
                <strong>@Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)</strong>
                of
                <strong>@Model.TotalCount</strong>
                categories
            </div>

            <div class="category-pagination-buttons">

                <!-- Previous -->
                <a asp-action="Index"
                   asp-route-pageSize="@pageSize"
                   asp-route-page="@(Model.PageNumber - 1)"
                   class="category-page-btn @(Model.HasPreviousPage ? "" : "disabled")">

                    <i class="bi bi-chevron-left"></i>

                </a>

                <!-- Page Numbers -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-action="Index"
                       asp-route-pageSize="@pageSize"
                       asp-route-page="@i"
                       class="category-page-btn @(Model.PageNumber == i ? "current" : "")">

                        @i

                    </a>
                }

                <!-- Next -->
                <a asp-action="Index"
                   asp-route-pageSize="@pageSize"
                   asp-route-page="@(Model.PageNumber + 1)"
                   class="category-page-btn @(Model.HasNextPage ? "" : "disabled")">

                    <i class="bi bi-chevron-right"></i>

                </a>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("categorySearchInput");
            const statusFilter = document.getElementById("categoryStatusFilter");
            const clearButton = document.getElementById("clearCategoryFilters");

            const tableBody = document.getElementById("categoryTableBody");
            const noResultsRow = document.getElementById("noCategoryResults");

            if (!tableBody) return;

            const categoryRows = Array.from(
                tableBody.querySelectorAll(".category-row")
            );

            function filterCategories() {

                const searchValue = searchInput.value.trim().toLowerCase();
                const selectedStatus = statusFilter.value;

                let visibleCount = 0;

                categoryRows.forEach(row => {

                    const name = (row.dataset.name || "").toLowerCase();
                    const slug = (row.dataset.slug || "").toLowerCase();
                    const parent = (row.dataset.parent || "").toLowerCase();

                    const matchesSearch =
                        name.includes(searchValue) ||
                        slug.includes(searchValue) ||
                        parent.includes(searchValue);

                    const categoryStatus = row.dataset.status;

                    const matchesStatus =
                        selectedStatus === "all" ||
                        categoryStatus === selectedStatus;

                    const isVisible = matchesSearch && matchesStatus;

                    row.style.display = isVisible ? "" : "none";

                    if (isVisible) {
                        visibleCount++;
                    }

                });

                if (noResultsRow) {
                    noResultsRow.style.display =
                        visibleCount === 0 ? "" : "none";
                }

            }

            // Live Search
            searchInput.addEventListener("input", filterCategories);

            // Live Status Filter
            statusFilter.addEventListener("change", filterCategories);

            // Clear Filters
            clearButton.addEventListener("click", function () {

                searchInput.value = "";
                statusFilter.value = "all";

                filterCategories();

            });

        });

        // Server-Side Page Size
        function changeCategoryPageSize(pageSize) {

            const url = new URL(window.location.href);

            url.searchParams.set("pageSize", pageSize);
            url.searchParams.set("page", "1");

            url.searchParams.delete("search");
            url.searchParams.delete("status");

            window.location.href = url.toString();

        }

    </script>

}
