@model Veltrix.DTOs.CategoryDTO.CreateCategoryDto

@{
    ViewData["Title"] = "Create Category";
    Layout = "_Layout";
}

<div class="category-page">

    <div class="category-heading">
        <div>
            <h1>Create Category</h1>
            <p>Add a new category to your store.</p>
        </div>

        <a asp-action="Index" class="vx-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Categories
        </a>
    </div>

    <div class="category-form-panel">

        <div class="category-form-header">
            <h5>Category Information</h5>
            <p>Fill in the information below to create a category.</p>
        </div>

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="row g-4">

                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">
                        Category Name <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="e.g. Electronics" />

                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Slug" class="form-label">
                        Slug <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Slug"
                           class="form-control"
                           placeholder="e.g. electronics" />

                    <span asp-validation-for="Slug" class="text-danger"></span>

                    <small class="form-text text-muted">
                        Used in the category URL.
                    </small>
                </div>

                <div class="col-md-6">
                    <label asp-for="ParentCategoryId" class="form-label">
                        Parent Category
                    </label>

                    <select asp-for="ParentCategoryId"
                            asp-items="ViewBag.ParentCategories"
                            class="form-select">
                        <option value="">No Parent Category</option>
                    </select>

                    <span asp-validation-for="ParentCategoryId"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DisplayOrder" class="form-label">
                        Display Order
                    </label>

                    <input asp-for="DisplayOrder"
                           type="number"
                           min="0"
                           class="form-control"
                           placeholder="0" />

                    <span asp-validation-for="DisplayOrder"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Write a short description..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ImageFile" class="form-label">
                        Category Image
                    </label>

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control"
                           accept="image/*" />

                    <span asp-validation-for="ImageFile"
                          class="text-danger"></span>

                    <small class="form-text text-muted">
                        Select an image for this category.
                    </small>

                    <div class="category-image-preview mt-3">
                        <img id="categoryImagePreview"
                             src=""
                             alt="Image preview"
                             style="display:none;" />
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label d-block">Status</label>

                    <div class="category-toggle-wrapper">
                        <input asp-for="IsActive"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="IsActive" class="form-check-label">
                            Active Category
                        </label>
                    </div>

                    <span asp-validation-for="IsActive"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="category-form-actions">

                <a asp-action="Index" class="vx-btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="vx-btn-primary">
                    <i class="bi bi-check-lg"></i>
                    Create Category
                </button>

            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageInput = document.getElementById("ImageFile");
        const imagePreview = document.getElementById("categoryImagePreview");

        imageInput?.addEventListener("change", function () {
            const file = this.files[0];

            if (!file) {
                imagePreview.src = "";
                imagePreview.style.display = "none";
                return;
            }

            imagePreview.src = URL.createObjectURL(file);
            imagePreview.style.display = "block";
        });
    </script>
}
