@model Veltrix.DTOs.CategoryDTO.UpdateCategoryDto

@{
    ViewData["Title"] = "Edit Category";
    Layout = "_Layout";

    var categoryId = (int)ViewBag.CategoryId;
    var currentImageUrl = ViewBag.CurrentImageUrl as string;
}

<div class="category-page">

    <div class="category-heading">
        <div>
            <h1>Edit Category</h1>
            <p>Update category information and settings.</p>
        </div>

        <a asp-action="Index" class="vx-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Categories
        </a>
    </div>

    <div class="category-form-panel">

        <div class="category-form-header">
            <h5>Edit Category Information</h5>
            <p>Update the information below and save your changes.</p>
        </div>

        <form asp-action="Edit"
              asp-route-id="@categoryId"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="row g-4">

                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">
                        Category Name <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Category name" />

                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Slug" class="form-label">
                        Slug <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Slug"
                           class="form-control"
                           placeholder="category-slug" />

                    <span asp-validation-for="Slug" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ParentCategoryId" class="form-label">
                        Parent Category
                    </label>

                    <select asp-for="ParentCategoryId"
                            asp-items="ViewBag.ParentCategories"
                            class="form-select">
                        <option value="">No Parent Category</option>
                    </select>

                    <span asp-validation-for="ParentCategoryId"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DisplayOrder" class="form-label">
                        Display Order
                    </label>

                    <input asp-for="DisplayOrder"
                           type="number"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="DisplayOrder"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Write a short description..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">

                    <label asp-for="ImageFile" class="form-label">
                        Replace Category Image
                    </label>

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control"
                           accept="image/*" />

                    <span asp-validation-for="ImageFile"
                          class="text-danger"></span>

                    <small class="form-text text-muted">
                        Leave empty to keep the current image.
                    </small>

                    <div class="category-image-preview mt-3">

                        @if (!string.IsNullOrWhiteSpace(currentImageUrl))
                        {
                            <img id="categoryImagePreview"
                                 src="@currentImageUrl"
                                 alt="Current category image" />
                        }
                        else
                        {
                            <img id="categoryImagePreview"
                                 src=""
                                 alt="Image preview"
                                 style="display:none;" />
                        }

                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label d-block">Status</label>

                    <div class="category-toggle-wrapper">
                        <input asp-for="IsActive"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="IsActive" class="form-check-label">
                            Active Category
                        </label>
                    </div>

                    <span asp-validation-for="IsActive"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="category-form-actions">

                <a asp-action="Index" class="vx-btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="vx-btn-primary">
                    <i class="bi bi-check-lg"></i>
                    Save Changes
                </button>

            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageInput = document.getElementById("ImageFile");
        const imagePreview = document.getElementById("categoryImagePreview");

        imageInput?.addEventListener("change", function () {
            const file = this.files[0];

            if (!file) {
                return;
            }

            imagePreview.src = URL.createObjectURL(file);
            imagePreview.style.display = "block";
        });
    </script>
}
